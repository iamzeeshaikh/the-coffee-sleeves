# SMTP settings for the quote/contact form endpoint (/api/quote).
# Set these in Vercel Project Settings → Environment Variables.
# Never commit real credentials.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=replace-with-smtp-password

# Where quote requests are delivered
QUOTE_TO_EMAIL=info@thecoffeesleeves.com
# From address shown on outgoing mail (must be permitted by your SMTP provider)
QUOTE_FROM_EMAIL=website@thecoffeesleeves.com
