---
import BaseLayout from '../layouts/BaseLayout.astro';
import TermsBody from '../components/pagebody/TermsBody.astro';
import { site } from '../utils/site';
import { breadcrumbs, webPage, faqPage } from '../utils/schema';
import PageExtras from '../components/PageExtras.astro';
import { extraFaqs } from '../utils/page-extras';

const faqs = extraFaqs('terms-conditions');

const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Terms and Conditions', url: '/terms-conditions/' },
  ]),
  webPage({
    path: '/terms-conditions/',
    name: 'Terms and Conditions - The Coffee Sleeves',
    description: 'Terms and conditions for using thecoffeesleeves.com and ordering custom printed cup sleeves: quotes, proofs, payment, production, delivery and returns.',
  }),
  faqPage(faqs),
];
---

<BaseLayout
  title='Terms and Conditions - The Coffee Sleeves'
  description='Terms and conditions for using thecoffeesleeves.com and ordering custom printed cup sleeves: quotes, proofs, payment, production, delivery and returns.'
  path="/terms-conditions/"
  schemas={schemas}
  offsetHeader={true}
>
  <div class="tcs-policy-wrap"><TermsBody /></div>
  <PageExtras extra={{ sections: [], faqs }} id="policy" />
</BaseLayout>

<style>
  .tcs-policy-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 30px 20px 60px;
  }
  .tcs-policy-wrap :global(.tcs-policy-title) {
    font-size: 2rem;
    color: #2c1810;
  }
</style>
