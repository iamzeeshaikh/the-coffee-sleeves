---
import BaseLayout from '../layouts/BaseLayout.astro';
import TermsBody from '../components/pagebody/TermsBody.astro';
import { site } from '../utils/site';
import { breadcrumbs, webPage } from '../utils/schema';

const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Terms and Conditions', url: '/terms-conditions/' },
  ]),
  webPage({
    path: '/terms-conditions/',
    name: 'Terms and Conditions - The Coffee Sleeves',
    description: 'Terms and conditions governing use of thecoffeesleeves.com and orders for custom coffee sleeve products.',
  }),
];
---

<BaseLayout
  title='Terms and Conditions - The Coffee Sleeves'
  description='Terms and conditions governing use of thecoffeesleeves.com and orders for custom coffee sleeve products.'
  path="/terms-conditions/"
  schemas={schemas}
  offsetHeader={true}
>
  <div class="tcs-policy-wrap"><TermsBody /></div>
</BaseLayout>

<style>
  .tcs-policy-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 30px 20px 60px;
  }
  .tcs-policy-wrap :global(.tcs-policy-title) {
    font-size: 2rem;
    color: #2c1810;
  }
</style>
