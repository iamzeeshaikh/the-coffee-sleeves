---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBody from '../components/pagebody/ContactBody.astro';
import { site } from '../utils/site';
import { breadcrumbs, webPage } from '../utils/schema';

const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' },
  ]),
  webPage({
    path: '/contact/',
    name: 'Contact - The Coffee Sleeves',
    description: 'Contact The Coffee Sleeves — call (503) 461-4788 or email info@thecoffeesleeves.com for custom coffee sleeve quotes, samples and support.',
    type: 'ContactPage',
  }),
];
---

<BaseLayout
  title='Contact - The Coffee Sleeves'
  description='Contact The Coffee Sleeves — call (503) 461-4788 or email info@thecoffeesleeves.com for custom coffee sleeve quotes, samples and support.'
  path="/contact/"
  schemas={schemas}
  offsetHeader={false}
>
  <ContactBody />
</BaseLayout>

