---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBody from '../components/pagebody/ContactBody.astro';
import { site } from '../utils/site';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact/` },
    ],
  },
];
---

<BaseLayout
  title='Contact - The Coffee Sleeves'
  description='Contact The Coffee Sleeves — call (503) 358-0443 or email info@thecoffeesleeves.com for custom coffee sleeve quotes, samples and support.'
  path="/contact/"
  schemas={schemas}
  offsetHeader={false}
>
  <ContactBody />
</BaseLayout>

