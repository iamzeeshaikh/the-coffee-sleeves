---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBody from '../components/pagebody/ContactBody.astro';
import { site } from '../utils/site';
import { breadcrumbs, webPage, faqPage } from '../utils/schema';
import PageExtras from '../components/PageExtras.astro';
import { pageExtras } from '../utils/page-extras';

const extra = pageExtras['contact'];

const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' },
  ]),
  webPage({
    path: '/contact/',
    name: extra.metaTitle,
    description: extra.metaDescription,
    type: 'ContactPage',
  }),
  faqPage(extra.faqs),
];
---

<BaseLayout
  title={extra.metaTitle}
  description={extra.metaDescription}
  path="/contact/"
  schemas={schemas}
  offsetHeader={false}
>
  <ContactBody />
  <PageExtras extra={extra} id="contact" />
</BaseLayout>

