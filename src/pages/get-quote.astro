---
import BaseLayout from '../layouts/BaseLayout.astro';
import GetQuoteBody from '../components/pagebody/GetQuoteBody.astro';
import { site } from '../utils/site';
import { breadcrumbs, webPage } from '../utils/schema';

const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Get Quote', url: '/get-quote/' },
  ]),
  webPage({
    path: '/get-quote/',
    name: 'Get Quote - The Coffee Sleeves',
    description: 'Request a free custom coffee sleeve quote. Tell us your quantity, material and design and we',
  }),
];
---

<BaseLayout
  title='Get Quote - The Coffee Sleeves'
  description="Request a free custom coffee sleeve quote. Tell us your quantity, material and design and we'll get back to you within 24 hours."
  path="/get-quote/"
  schemas={schemas}
  offsetHeader={false}
>
  <GetQuoteBody />
</BaseLayout>

