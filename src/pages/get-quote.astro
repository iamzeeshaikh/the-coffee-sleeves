---
import BaseLayout from '../layouts/BaseLayout.astro';
import GetQuoteBody from '../components/pagebody/GetQuoteBody.astro';
import { site } from '../utils/site';
import { breadcrumbs, webPage, faqPage } from '../utils/schema';
import PageExtras from '../components/PageExtras.astro';
import { pageExtras } from '../utils/page-extras';

const extra = pageExtras['get-quote'];

const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Get Quote', url: '/get-quote/' },
  ]),
  webPage({
    path: '/get-quote/',
    name: extra.metaTitle,
    description: extra.metaDescription,
  }),
  faqPage(extra.faqs),
];
---

<BaseLayout
  title={extra.metaTitle}
  description={extra.metaDescription}
  path="/get-quote/"
  schemas={schemas}
  offsetHeader={false}
>
  <GetQuoteBody />
  <PageExtras extra={extra} id="get-quote" />
</BaseLayout>

