---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqBody from '../components/pagebody/FaqBody.astro';
import { site } from '../utils/site';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${site.url}/faq/` },
    ],
  },
];
---

<BaseLayout
  title='FAQ - The Coffee Sleeves'
  description='Frequently asked questions about custom coffee sleeves — minimum order quantities, materials, printing options, delivery times and ordering process.'
  path="/faq/"
  schemas={schemas}
  offsetHeader={false}
>
  <FaqBody />
</BaseLayout>

