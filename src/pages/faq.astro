---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqBody from '../components/pagebody/FaqBody.astro';
import { breadcrumbs, faqPage } from '../utils/schema';
import faqs from '../data/faq-page.json';

/* faq-page.json holds the twenty question/answer pairs FaqBody renders,
   extracted from that component's markup so the two cannot disagree. */
const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'FAQ', url: '/faq/' },
  ]),
  faqPage(faqs),
];
---

<BaseLayout
  title='FAQ - The Coffee Sleeves'
  description='Frequently asked questions about custom coffee sleeves — minimum order quantities, materials, printing options, delivery times and ordering process.'
  path="/faq/"
  schemas={schemas}
  offsetHeader={false}
>
  <FaqBody />
</BaseLayout>

