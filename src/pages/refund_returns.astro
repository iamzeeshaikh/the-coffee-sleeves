---
import BaseLayout from '../layouts/BaseLayout.astro';
import RefundBody from '../components/pagebody/RefundBody.astro';
import { site } from '../utils/site';
import { breadcrumbs, webPage } from '../utils/schema';

const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Refund and Returns Policy', url: '/refund_returns/' },
  ]),
  webPage({
    path: '/refund_returns/',
    name: 'Refund and Returns Policy - The Coffee Sleeves',
    description: 'Refund and returns policy for The Coffee Sleeves — return windows, conditions, exchanges and refund processing times.',
  }),
];
---

<BaseLayout
  title='Refund and Returns Policy - The Coffee Sleeves'
  description='Refund and returns policy for The Coffee Sleeves — return windows, conditions, exchanges and refund processing times.'
  path="/refund_returns/"
  schemas={schemas}
  offsetHeader={true}
>
  <div class="tcs-policy-wrap"><RefundBody /></div>
</BaseLayout>

<style>
  .tcs-policy-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 30px 20px 60px;
  }
  .tcs-policy-wrap :global(.tcs-policy-title) {
    font-size: 2rem;
    color: #2c1810;
  }
</style>
