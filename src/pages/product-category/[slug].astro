---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveGrid from '../../components/ArchiveGrid.astro';
import { categories, productsInCategory, site } from '../../utils/site';
import { breadcrumbs, collectionPage } from '../../utils/schema';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const path = `/product-category/${category.slug}/`;
const items = productsInCategory(category.name);

const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: category.name, url: path },
  ]),
  // Was a bare ItemList with no page owning it, and its entries carried a URL
  // but no name.
  collectionPage({
    path,
    name: category.name,
    description: category.metaDescription,
    items: items.map((p) => ({ name: p.name, url: `/product/${p.slug}/` })),
  }),
];
---

<BaseLayout
  title={category.metaTitle}
  description={category.metaDescription}
  path={path}
  schemas={schemas}
>
  <ArchiveGrid heading={category.name} intro={category.blurb} products={items} currentCategorySlug={category.slug} />
</BaseLayout>
