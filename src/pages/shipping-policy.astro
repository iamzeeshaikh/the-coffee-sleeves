---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShippingBody from '../components/pagebody/ShippingBody.astro';
import { site } from '../utils/site';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Shipping Policy', item: `${site.url}/shipping-policy/` },
    ],
  },
];
---

<BaseLayout
  title='Shipping Policy - The Coffee Sleeves'
  description='Shipping policy for The Coffee Sleeves — processing times, shipping methods, rates and estimated delivery windows.'
  path="/shipping-policy/"
  schemas={schemas}
  offsetHeader={true}
>
  <div class="tcs-policy-wrap"><ShippingBody /></div>
</BaseLayout>

<style>
  .tcs-policy-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 30px 20px 60px;
  }
  .tcs-policy-wrap :global(.tcs-policy-title) {
    font-size: 2rem;
    color: #2c1810;
  }
</style>
