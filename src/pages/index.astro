---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import CategoryCards from '../components/home/CategoryCards.astro';
import WhyChoose from '../components/home/WhyChoose.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import FeaturedProducts from '../components/home/FeaturedProducts.astro';
import Industries from '../components/home/Industries.astro';
import Customization from '../components/home/Customization.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import CtaBanner from '../components/home/CtaBanner.astro';
import LeadSection from '../components/home/LeadSection.astro';
import site from '../data/site.json';

// Organization and WebSite come from BaseLayout on every route.
const schemas: object[] = [];
---

<BaseLayout
  title={site.homeMeta.title}
  description={site.homeMeta.description}
  path="/"
  ogImage="/images/Custom-coffee-sleeves-Reusable.jpg"
  schemas={schemas}
  offsetHeader={false}
>
  <Hero />
  <TrustBar />
  <CategoryCards />
  <WhyChoose />
  <HowItWorks />
  <FeaturedProducts />
  <Industries />
  <Customization />
  <HomeFaq />
  <CtaBanner />
  <LeadSection />
</BaseLayout>
