---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveGrid from '../components/ArchiveGrid.astro';
import { products, site } from '../utils/site';
import { breadcrumbs, collectionPage } from '../utils/schema';

// Was a bare ItemList with no breadcrumb and no page owning it, and its
// entries carried a URL but no name.
const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Shop', url: '/shop/' },
  ]),
  collectionPage({
    path: '/shop/',
    name: 'Shop',
    description:
      'Browse all custom coffee sleeves and cup sleeves from The Coffee Sleeves.',
    items: products.map((p) => ({ name: p.name, url: `/product/${p.slug}/` })),
  }),
];
---

<BaseLayout
  title="Shop - The Coffee Sleeves"
  description="Browse all custom coffee sleeves and cup sleeves from The Coffee Sleeves — cardboard, kraft, paper, printed, branded and more. Request a free quote."
  path="/shop/"
  schemas={schemas}
>
  <ArchiveGrid heading="Shop" products={products} />
</BaseLayout>
