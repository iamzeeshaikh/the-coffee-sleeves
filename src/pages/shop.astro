---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveGrid from '../components/ArchiveGrid.astro';
import { products, site } from '../utils/site';
import { breadcrumbs, collectionPage, faqPage } from '../utils/schema';
import PageExtras from '../components/PageExtras.astro';
import { pageExtras } from '../utils/page-extras';

const extra = pageExtras['shop'];

// Was a bare ItemList with no breadcrumb and no page owning it, and its
// entries carried a URL but no name.
const schemas = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Shop', url: '/shop/' },
  ]),
  collectionPage({
    path: '/shop/',
    name: 'Shop',
    description: extra.metaDescription,
    items: products.map((p) => ({ name: p.name, url: `/product/${p.slug}/` })),
  }),
  faqPage(extra.faqs),
];
---

<BaseLayout
  title={extra.metaTitle}
  description={extra.metaDescription}
  path="/shop/"
  schemas={schemas}
>
  <ArchiveGrid heading="Shop" intro={extra.blurb} products={products} />
  <PageExtras extra={extra} id="shop" />
</BaseLayout>
