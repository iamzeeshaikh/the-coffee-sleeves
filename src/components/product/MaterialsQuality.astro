<script is:inline>
(function() {
    'use strict';
    
    // Animate certifications on scroll
    function initCertificationAnimations() {
        const certItems = document.querySelectorAll('.tcs-certification-item');
        
        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px 0px -100px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        const icon = entry.target.querySelector('.tcs-cert-icon');
                        if (icon) {
                            icon.style.animation = 'pulse 0.6s ease';
                            setTimeout(() => {
                                icon.style.animation = '';
                            }, 600);
                        }
                    }, index * 100);
                }
            });
        }, observerOptions);
        
        certItems.forEach(item => {
            observer.observe(item);
        });
    }
    
    // 3D Tilt effect for material cards
    function init3DTiltCards() {
        const cards = document.querySelectorAll('.tcs-material-detail-card');
        
        cards.forEach(card => {
            card.addEventListener('mousemove', function(e) {
                if (window.innerWidth <= 768) return;
                
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = (y - centerY) / 15;
                const rotateY = (centerX - x) / 15;
                
                card.style.transform = `translateY(-15px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            });
            
            card.addEventListener('mouseleave', function() {
                card.style.transform = '';
            });
        });
    }
    
    // Animate stats counter
    function animateStats() {
        const stats = document.querySelectorAll('.tcs-stat-value');
        
        const observerOptions = {
            threshold: 0.5
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const stat = entry.target;
                    const text = stat.textContent;
                    
                    // Skip non-numeric values
                    if (text === 'FSC' || text === '0') {
                        stat.style.animation = 'pulse 0.6s ease';
                        return;
                    }
                    
                    // Animate percentage
                    if (text.includes('%')) {
                        let current = 0;
                        const target = parseInt(text);
                        const increment = target / 30;
                        
                        const timer = setInterval(() => {
                            current += increment;
                            if (current >= target) {
                                stat.textContent = target + '%';
                                clearInterval(timer);
                            } else {
                                stat.textContent = Math.floor(current) + '%';
                            }
                        }, 50);
                    }
                    
                    observer.unobserve(stat);
                }
            });
        }, observerOptions);
        
        stats.forEach(stat => {
            observer.observe(stat);
        });
    }
    
    // Highlight table rows on hover
    function initTableHighlight() {
        const rows = document.querySelectorAll('.tcs-comparison-table tbody tr');
        
        rows.forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.backgroundColor = 'rgba(76, 175, 80, 0.1)';
            });
            
            row.addEventListener('mouseleave', function() {
                this.style.backgroundColor = '';
            });
        });
    }
    
    // Initialize
    function init() {
        initCertificationAnimations();
        
        if (window.innerWidth > 768) {
            init3DTiltCards();
        }
        
        animateStats();
        initTableHighlight();
        
        console.log('The Coffee Sleeves Materials & Quality - Initialized');
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
})();
</script>
