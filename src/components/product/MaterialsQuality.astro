<style is:global>
/* Materials & Quality Section */
.tcs-materials-quality {
    position: relative;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFF8F0 50%, #FFFFFF 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Background Decoration */
.tcs-materials-quality::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 10% 20%, rgba(255, 140, 66, 0.04) 0%, transparent 50%),
        radial-gradient(circle at 90% 80%, rgba(76, 175, 80, 0.04) 0%, transparent 50%);
    animation: bgPulse 20s ease-in-out infinite;
}

@keyframes bgPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
}

.tcs-materials-quality-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Section Header */
.tcs-materials-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tcs-materials-badge {
    display: inline-block;
    background: linear-gradient(135deg, #4CAF50, #388E3C);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 5px 15px rgba(76, 175, 80, 0.4);
}

.tcs-materials-title {
    font-size: 3rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
}

.tcs-materials-subtitle {
    font-size: 1.2rem;
    color: #666666;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Certifications Bar */
.tcs-certifications-bar {
    background: white;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    margin-bottom: 60px;
    animation: fadeInScale 0.8s ease-out 0.3s backwards;
}

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.tcs-certifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 30px;
    align-items: center;
}

.tcs-certification-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    perspective: 1000px;
}

.tcs-cert-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #4CAF50, #388E3C);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(76, 175, 80, 0.4);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
}

.tcs-cert-icon::before {
    content: '';
    position: absolute;
    top: -5px;
    left: -5px;
    right: -5px;
    bottom: -5px;
    background: linear-gradient(135deg, #4CAF50, #388E3C);
    border-radius: 50%;
    opacity: 0.3;
    filter: blur(15px);
    z-index: -1;
    transition: all 0.3s ease;
}

.tcs-certification-item:hover .tcs-cert-icon {
    transform: translateY(-10px) rotateY(180deg) scale(1.1);
    box-shadow: 0 15px 40px rgba(76, 175, 80, 0.6);
}

.tcs-certification-item:hover .tcs-cert-icon::before {
    opacity: 0.6;
    filter: blur(20px);
}

.tcs-cert-icon svg {
    width: 40px;
    height: 40px;
    fill: white;
}

.tcs-cert-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #2C1810;
}

.tcs-cert-desc {
    font-size: 0.75rem;
    color: #666666;
}

/* Material Cards Grid */
.tcs-materials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
}

/* Material Card */
.tcs-material-detail-card {
    background: white;
    border-radius: 20px;
    padding: 35px 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    perspective: 1500px;
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
    animation: fadeInScale 0.8s ease-out backwards;
}

.tcs-material-detail-card:nth-child(1) { animation-delay: 0.1s; }
.tcs-material-detail-card:nth-child(2) { animation-delay: 0.2s; }
.tcs-material-detail-card:nth-child(3) { animation-delay: 0.3s; }
.tcs-material-detail-card:nth-child(4) { animation-delay: 0.4s; }

.tcs-material-detail-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(90deg, #4CAF50, #8BC34A);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s ease;
}

.tcs-material-detail-card:hover {
    transform: translateY(-15px) rotateX(5deg);
    box-shadow: 
        0 25px 60px rgba(0, 0, 0, 0.15),
        0 0 40px rgba(76, 175, 80, 0.2);
    border-color: rgba(76, 175, 80, 0.3);
}

.tcs-material-detail-card:hover::before {
    transform: scaleX(1);
}

.tcs-material-image {
    width: 100%;
    height: 180px;
    background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
    border-radius: 15px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.tcs-material-image::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
        45deg,
        transparent,
        rgba(255, 255, 255, 0.3),
        transparent
    );
    transform: rotate(45deg);
    transition: all 0.5s ease;
    opacity: 0;
}

.tcs-material-detail-card:hover .tcs-material-image {
    transform: scale(1.05);
}

.tcs-material-detail-card:hover .tcs-material-image::after {
    opacity: 1;
    animation: shine 0.8s ease;
}

@keyframes shine {
    from { left: -50%; }
    to { left: 150%; }
}

.tcs-material-name {
    font-size: 1.5rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 12px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-material-description {
    font-size: 0.95rem;
    color: #666666;
    line-height: 1.7;
    margin-bottom: 20px;
}

.tcs-material-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.tcs-material-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: #2C1810;
}

.tcs-material-feature::before {
    content: '✓';
    width: 24px;
    height: 24px;
    background: linear-gradient(135deg, #4CAF50, #388E3C);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.8rem;
    flex-shrink: 0;
}

/* Comparison Table */
.tcs-comparison-section {
    background: white;
    border-radius: 20px;
    padding: 50px 40px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out 0.5s backwards;
}

.tcs-comparison-title {
    font-size: 2rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 30px;
    text-align: center;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-comparison-table {
    width: 100%;
    border-collapse: collapse;
    overflow: hidden;
    border-radius: 12px;
}

.tcs-comparison-table thead {
    background: linear-gradient(135deg, #4CAF50, #388E3C);
    color: white;
}

.tcs-comparison-table th {
    padding: 18px 15px;
    font-weight: 700;
    text-align: left;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.tcs-comparison-table tbody tr {
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
}

.tcs-comparison-table tbody tr:hover {
    background: rgba(76, 175, 80, 0.05);
    transform: scale(1.01);
}

.tcs-comparison-table td {
    padding: 18px 15px;
    font-size: 0.9rem;
    color: #2C1810;
}

.tcs-comparison-table td:first-child {
    font-weight: 700;
}

.tcs-check-icon {
    color: #4CAF50;
    font-weight: 700;
    font-size: 1.2rem;
}

.tcs-times-icon {
    color: #F44336;
    font-weight: 700;
    font-size: 1.2rem;
}

/* Quality Guarantee Section */
.tcs-quality-guarantee {
    background: linear-gradient(135deg, rgba(76, 175, 80, 0.08), rgba(139, 195, 74, 0.08));
    border-radius: 20px;
    padding: 50px 40px;
    border: 2px solid rgba(76, 175, 80, 0.2);
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out 0.6s backwards;
}

.tcs-guarantee-header {
    text-align: center;
    margin-bottom: 40px;
}

.tcs-guarantee-icon {
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, #4CAF50, #388E3C);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 15px 40px rgba(76, 175, 80, 0.5);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.tcs-guarantee-icon svg {
    width: 50px;
    height: 50px;
    fill: white;
}

.tcs-guarantee-title {
    font-size: 2rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-guarantee-subtitle {
    font-size: 1.1rem;
    color: #666666;
    max-width: 600px;
    margin: 0 auto;
}

.tcs-guarantee-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.tcs-guarantee-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 20px;
    background: white;
    border-radius: 12px;
    transition: all 0.3s ease;
}

.tcs-guarantee-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
}

.tcs-guarantee-item-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #4CAF50, #388E3C);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tcs-guarantee-item-icon svg {
    width: 24px;
    height: 24px;
    fill: white;
}

.tcs-guarantee-item-content h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #2C1810;
    margin-bottom: 8px;
}

.tcs-guarantee-item-content p {
    font-size: 0.9rem;
    color: #666666;
    line-height: 1.6;
    margin: 0;
}

/* Sustainability Section */
.tcs-sustainability {
    background: white;
    border-radius: 20px;
    padding: 50px 40px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    text-align: center;
    animation: fadeInUp 0.8s ease-out 0.7s backwards;
}

.tcs-sustainability-icon {
    width: 90px;
    height: 90px;
    background: linear-gradient(135deg, #4CAF50, #8BC34A);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    box-shadow: 0 10px 30px rgba(76, 175, 80, 0.4);
    animation: rotate 20s linear infinite;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.tcs-sustainability-icon svg {
    width: 50px;
    height: 50px;
    fill: white;
}

.tcs-sustainability-title {
    font-size: 2rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 20px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-sustainability-text {
    font-size: 1.1rem;
    color: #666666;
    line-height: 1.8;
    max-width: 800px;
    margin: 0 auto 30px;
}

.tcs-sustainability-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    margin-top: 40px;
}

.tcs-stat-item {
    perspective: 1000px;
}

.tcs-stat-value {
    font-size: 3rem;
    font-weight: 900;
    color: #4CAF50;
    font-family: 'Impact', 'Arial Black', sans-serif;
    margin-bottom: 10px;
    transition: all 0.3s ease;
}

.tcs-stat-item:hover .tcs-stat-value {
    transform: scale(1.15) rotateY(10deg);
    text-shadow: 0 5px 15px rgba(76, 175, 80, 0.3);
}

.tcs-stat-label {
    font-size: 1rem;
    color: #666666;
    font-weight: 600;
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-materials-title {
        font-size: 2.5rem;
    }
    
    .tcs-comparison-table {
        font-size: 0.85rem;
    }
}

@media (max-width: 768px) {
    .tcs-materials-quality {
        padding: 60px 0;
    }
    
    .tcs-materials-title {
        font-size: 2rem;
    }
    
    .tcs-materials-subtitle {
        font-size: 1rem;
    }
    
    .tcs-certifications-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }
    
    .tcs-materials-grid {
        grid-template-columns: 1fr;
    }
    
    .tcs-comparison-section {
        padding: 30px 20px;
        overflow-x: auto;
    }
    
    .tcs-comparison-table {
        min-width: 600px;
    }
    
    .tcs-quality-guarantee {
        padding: 40px 25px;
    }
    
    .tcs-guarantee-features {
        grid-template-columns: 1fr;
    }
    
    .tcs-sustainability {
        padding: 40px 25px;
    }
    
    .tcs-sustainability-stats {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .tcs-materials-title {
        font-size: 1.75rem;
    }
    
    .tcs-certifications-grid {
        grid-template-columns: 1fr;
    }
    
    .tcs-stat-value {
        font-size: 2.5rem;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-material-detail-card,
    .tcs-cert-icon,
    .tcs-guarantee-icon,
    .tcs-sustainability-icon,
    .tcs-materials-quality::before {
        animation: none !important;
    }
}
</style>

