                </div>
                
                <!-- Color Picker -->
                <div class="tcs-option-card">
                    <div class="tcs-option-label">
                        <svg class="tcs-option-label-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                        </svg>
                        <span>Base Color</span>
                    </div>
                    <div class="tcs-color-picker-wrapper">
                        <div class="tcs-color-preview" id="tcsColorPreview"></div>
                        <input type="color" name="color" class="tcs-color-input" id="tcsColorInput" value="#D2691E">
                    </div>
                    <div class="tcs-color-presets">
                        <div class="tcs-color-preset selected" data-color="#D2691E" style="background: #D2691E;"></div>
                        <div class="tcs-color-preset" data-color="#8B4513" style="background: #8B4513;"></div>
                        <div class="tcs-color-preset" data-color="#2C1810" style="background: #2C1810;"></div>
                        <div class="tcs-color-preset" data-color="#FF8C42" style="background: #FF8C42;"></div>
                        <div class="tcs-color-preset" data-color="#FFFFFF" style="background: #FFFFFF; border: 1px solid #ddd;"></div>
