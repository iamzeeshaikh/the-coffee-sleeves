            </div>
            
            <!-- Preview Column -->
            <div class="tcs-customization-preview">
                <div class="tcs-preview-card">
                    <div class="tcs-preview-label">Live Preview</div>
                    
                    <div class="tcs-preview-mockup">
                        <div class="tcs-mockup-sleeve" id="tcsMockupSleeve">
                            <div class="tcs-mockup-design" id="tcsMockupDesign">
                                Your Brand Here
                            </div>
                        </div>
                    </div>
                    
                    <div class="tcs-preview-details">
                        <div class="tcs-preview-detail">
                            <span class="tcs-preview-detail-label">Material:</span>
                            <span class="tcs-preview-detail-value" id="tcsPreviewMaterial">Kraft Paper</span>
                        </div>
                        <div class="tcs-preview-detail">
                            <span class="tcs-preview-detail-label">Size:</span>
                            <span class="tcs-preview-detail-value" id="tcsPreviewSize">12oz</span>
                        </div>
                        <div class="tcs-preview-detail">
                            <span class="tcs-preview-detail-label">Quantity:</span>
                            <span class="tcs-preview-detail-value" id="tcsPreviewQuantity">1,000 units</span>
                        </div>
                        <div class="tcs-preview-detail">
                            <span class="tcs-preview-detail-label">Printing:</span>
                            <span class="tcs-preview-detail-value" id="tcsPreviewPrinting">Digital Print</span>
                        </div>
                        <div class="tcs-preview-detail">
                            <span class="tcs-preview-detail-label">Finish:</span>
                            <span class="tcs-preview-detail-value" id="tcsPreviewFinish">Gloss</span>
                        </div>
                    </div>
                    
                    <div class="tcs-preview-price">
                        <div class="tcs-price-label">Pricing</div>
                        <div class="tcs-price-value" id="tcsPriceValue">Custom Quote</div>
                        <div class="tcs-price-unit" id="tcsPriceUnit">(quoted within 24 hours)</div>
                    </div>
                    
                    <button type="submit" class="tcs-add-quote-btn" id="tcsAddQuoteBtn">
                        Request Quote
                    </button>
                    
                    <div class="tcs-message" id="tcsMessage"></div>
                </div>
            </div>
            
        </form>
        
    </div>
</section>

<script is:inline>
(function() {
    'use strict';
    
    // Configuration
    const config = {
        material: 'kraft',
        size: '12oz',
        quantity: 1000,
        printing: 'digital',
        finish: 'gloss',
        color: '#D2691E'
    };
    
    // Pricing logic
    function calculatePrice() {
        const basePrice = 0.80;
        let price = basePrice;
        
        if (config.material === 'cardboard') price += 0.03;
        if (config.material === 'corrugated') price += 0.05;
        if (config.finish === 'uv') price += 0.05;
        
        if (config.quantity >= 5000) price *= 0.85;
        else if (config.quantity >= 2000) price *= 0.90;
        else if (config.quantity >= 1000) price *= 0.95;
        
        const total = price * config.quantity;
        
        return {
            perUnit: price.toFixed(2),
            total: total.toFixed(0)
        };
    }
    
    // Update preview
    function updatePreview() {
        const mockup = document.getElementById('tcsMockupSleeve');
        if (mockup) {
            mockup.style.background = `linear-gradient(135deg, ${config.color}, ${adjustBrightness(config.color, -30)})`;
        }
        
        document.getElementById('tcsPreviewMaterial').textContent = getReadableMaterial();
        document.getElementById('tcsPreviewSize').textContent = config.size;
        document.getElementById('tcsPreviewQuantity').textContent = config.quantity.toLocaleString() + ' units';
        document.getElementById('tcsPreviewPrinting').textContent = getReadablePrinting();
        document.getElementById('tcsPreviewFinish').textContent = getReadableFinish();
        
        // Pricing is quoted per order; the preview intentionally shows no computed price.
    }
    
    // Helper functions
    function getReadableMaterial() {
        const materials = {
            kraft: 'Kraft Paper',
            cardboard: 'White Cardboard',
            corrugated: 'Corrugated',
            recycled: 'Recycled'
        };
        return materials[config.material] || config.material;
    }
    
    function getReadablePrinting() {
        const printing = {
            digital: 'Digital Print',
            offset: 'Offset Print',
            screen: 'Screen Print'
        };
        return printing[config.printing] || config.printing;
    }
    
    function getReadableFinish() {
        const finish = {
            gloss: 'Gloss',
            matte: 'Matte',
            uv: 'Spot UV'
        };
        return finish[config.finish] || config.finish;
    }
    
    function adjustBrightness(color, percent) {
        const num = parseInt(color.replace("#",""), 16);
        const amt = Math.round(2.55 * percent);
        const R = (num >> 16) + amt;
        const G = (num >> 8 & 0x00FF) + amt;
        const B = (num & 0x0000FF) + amt;
        return "#" + (0x1000000 + (R<255?R<1?0:R:255)*0x10000 +
            (G<255?G<1?0:G:255)*0x100 + (B<255?B<1?0:B:255))
            .toString(16).slice(1);
    }
    
    // Form submission
    function initFormSubmission() {
        const form = document.getElementById('tcsQuoteForm');
        const submitBtn = document.getElementById('tcsAddQuoteBtn');
        const message = document.getElementById('tcsMessage');
        
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Hide previous messages
            message.classList.remove('show', 'success', 'error');
            
            // Validate required fields
            const name = form.querySelector('[name="name"]').value.trim();
            const email = form.querySelector('[name="email"]').value.trim();
            const phone = form.querySelector('[name="phone"]').value.trim();
            
            if (!name || !email || !phone) {
                showMessage('Please fill in all required fields.', 'error');
                return;
            }
            
            // Disable button and show loading
            submitBtn.disabled = true;
            submitBtn.classList.add('loading');
            submitBtn.textContent = 'Sending...';
            
            try {
                // Prepare form data
                const formData = new FormData(form);
                
                // Add preview details
                formData.append('material_name', getReadableMaterial());
                formData.append('printing_name', getReadablePrinting());
                formData.append('finish_name', getReadableFinish());

                
                // Send to server
                const response = await fetch('/api/quote/', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (result.success) {
                    window.location.assign('/thank-you/');
                } else {
                    showMessage('✗ ' + (result.message || 'Something went wrong. Please try again.'), 'error');
                }
                
            } catch (error) {
                console.error('Form submission error:', error);
                showMessage('✗ Unable to send request. Please try again or contact us directly at info@thecoffeesleeves.com', 'error');
            } finally {
                // Re-enable button
                submitBtn.disabled = false;
                submitBtn.classList.remove('loading');
                submitBtn.textContent = 'Request Quote';
            }
        });
    }
    
    function showMessage(text, type) {
        const message = document.getElementById('tcsMessage');
        message.textContent = text;
        message.className = 'tcs-message show ' + type;
        
        // Scroll to message
        message.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        
        // Auto-hide after 10 seconds
        if (type === 'success') {
            setTimeout(() => {
                message.classList.remove('show');
            }, 10000);
        }
    }
    
    function resetToDefaults() {
        config.material = 'kraft';
        config.size = '12oz';
        config.quantity = 1000;
        config.printing = 'digital';
        config.finish = 'gloss';
        config.color = '#D2691E';
        
        document.querySelectorAll('.tcs-material-card').forEach(c => c.classList.remove('selected'));
        document.querySelector('[data-material="kraft"]').classList.add('selected');
        
        document.querySelectorAll('.tcs-size-option').forEach(o => o.classList.remove('selected'));
        document.querySelector('[data-size="12oz"]').classList.add('selected');
        
        document.getElementById('tcsQuantityInput').value = 1000;
        
        document.querySelectorAll('.tcs-printing-option').forEach(o => o.classList.remove('selected'));
        document.querySelector('[data-printing="digital"]').classList.add('selected');
        
        document.querySelectorAll('.tcs-finish-option').forEach(o => o.classList.remove('selected'));
        document.querySelector('[data-finish="gloss"]').classList.add('selected');
        
        document.getElementById('tcsColorInput').value = '#D2691E';
        document.getElementById('tcsColorPreview').style.background = '#D2691E';
        
        updatePreview();
    }
    
    // File Upload
    function initFileUpload() {
        const uploadArea = document.getElementById('tcsDesignUpload');
        const uploadInput = document.getElementById('tcsUploadInput');
        const uploadedFile = document.getElementById('tcsUploadedFile');
        const filename = document.getElementById('tcsFilename');
        const removeBtn = document.getElementById('tcsRemoveFile');
        
        uploadArea.addEventListener('click', () => uploadInput.click());
        
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('active');
        });
        
        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('active');
        });
        
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('active');
            if (e.dataTransfer.files.length) {
                uploadInput.files = e.dataTransfer.files;
                handleFile(e.dataTransfer.files[0]);
            }
        });
        
        uploadInput.addEventListener('change', (e) => {
            if (e.target.files.length) {
                handleFile(e.target.files[0]);
            }
        });
        
        removeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            uploadedFile.classList.remove('show');
            uploadInput.value = '';
        });
        
        function handleFile(file) {
            filename.textContent = file.name;
            uploadedFile.classList.add('show');
        }
    }
    
    // Material Selection
    function initMaterialSelection() {
        const cards = document.querySelectorAll('.tcs-material-card');
        const input = document.getElementById('tcsMaterialInput');
        
        cards.forEach(card => {
            card.addEventListener('click', function() {
                cards.forEach(c => c.classList.remove('selected'));
                this.classList.add('selected');
                config.material = this.dataset.material;
                input.value = config.material;
                updatePreview();
            });
        });
    }
    
    // Size Selection
    function initSizeSelection() {
        const options = document.querySelectorAll('.tcs-size-option');
        const input = document.getElementById('tcsSizeInput');
        
        options.forEach(option => {
            option.addEventListener('click', function() {
                options.forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                config.size = this.dataset.size;
                input.value = config.size;
                updatePreview();
            });
        });
    }
    
    // Quantity Selection
    function initQuantitySelection() {
        const input = document.getElementById('tcsQuantityInput');
        const minusBtn = document.getElementById('tcsQuantityMinus');
        const plusBtn = document.getElementById('tcsQuantityPlus');
        
        minusBtn.addEventListener('click', () => {
            const current = parseInt(input.value);
            if (current > 500) {
                input.value = current - 100;
                config.quantity = parseInt(input.value);
                updatePreview();
            }
        });
        
        plusBtn.addEventListener('click', () => {
            const current = parseInt(input.value);
            input.value = current + 100;
            config.quantity = parseInt(input.value);
            updatePreview();
        });
        
        input.addEventListener('change', () => {
            config.quantity = parseInt(input.value);
            updatePreview();
        });
    }
    
    // Printing Type Selection
    function initPrintingSelection() {
        const options = document.querySelectorAll('.tcs-printing-option');
        const input = document.getElementById('tcsPrintingInput');
        
        options.forEach(option => {
            option.addEventListener('click', function() {
                options.forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                config.printing = this.dataset.printing;
                input.value = config.printing;
                updatePreview();
            });
        });
    }
    
    // Finish Selection
    function initFinishSelection() {
        const options = document.querySelectorAll('.tcs-finish-option');
        const input = document.getElementById('tcsFinishInput');
        
        options.forEach(option => {
            option.addEventListener('click', function() {
                options.forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                config.finish = this.dataset.finish;
                input.value = config.finish;
                updatePreview();
            });
        });
    }
    
    // Color Picker
    function initColorPicker() {
        const preview = document.getElementById('tcsColorPreview');
        const input = document.getElementById('tcsColorInput');
        const presets = document.querySelectorAll('.tcs-color-preset');
        
        preview.addEventListener('click', () => input.click());
        
        input.addEventListener('input', (e) => {
            config.color = e.target.value;
            preview.style.background = config.color;
            updatePreview();
        });
        
        presets.forEach(preset => {
            preset.addEventListener('click', function() {
                presets.forEach(p => p.classList.remove('selected'));
                this.classList.add('selected');
                config.color = this.dataset.color;
                preview.style.background = config.color;
                input.value = config.color;
                updatePreview();
            });
        });
    }
    
    // Initialize
    function init() {
        initFormSubmission();
        initFileUpload();
        initMaterialSelection();
        initSizeSelection();
        initQuantitySelection();
        initPrintingSelection();
        initFinishSelection();
        initColorPicker();
        updatePreview();
        
        console.log('The Coffee Sleeves Customization - Initialized');
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
})();
</script>
