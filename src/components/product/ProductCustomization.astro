                                <div class="tcs-printing-desc">Vibrant colors, durable finish</div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Finish Options -->
                <div class="tcs-option-card">
                    <div class="tcs-option-label">
                        <svg class="tcs-option-label-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                            <line x1="9" y1="9" x2="9.01" y2="9"/>
                            <line x1="15" y1="9" x2="15.01" y2="9"/>
                        </svg>
                        <span>Finish</span>
                        <span class="tcs-option-required">*Required</span>
                    </div>
                    <input type="hidden" name="finish" value="gloss" id="tcsFinishInput">
                    <div class="tcs-finish-options">
                        <div class="tcs-finish-option selected" data-finish="gloss">
