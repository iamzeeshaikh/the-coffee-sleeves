    transition: all 0.3s ease;
    position: relative;
}

.tcs-comparison-cup:hover .tcs-cup-visual {
    box-shadow: 0 15px 35px rgba(255, 140, 66, 0.4);
    transform: scale(1.05);
}

.tcs-cup-8oz {
