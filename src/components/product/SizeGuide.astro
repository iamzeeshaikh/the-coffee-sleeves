    height: 120px;
}

.tcs-cup-20oz {
    width: 105px;
    height: 140px;
}

.tcs-cup-label {
    font-size: 1rem;
    font-weight: 700;
    color: #2C1810;
}

.tcs-cup-size {
    font-size: 0.85rem;
    color: #666666;
}

/* Download Template */
.tcs-download-section {
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 20px;
    padding: 50px 40px;
    text-align: center;
    box-shadow: 0 15px 50px rgba(255, 140, 66, 0.5);
    animation: fadeInScale 0.8s ease-out 0.8s backwards;
}

.tcs-download-content {
    max-width: 700px;
    margin: 0 auto;
}

.tcs-download-icon {
    width: 80px;
    height: 80px;
    background: white;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.tcs-download-icon svg {
    width: 40px;
    height: 40px;
    fill: #FF8C42;
}

.tcs-download-title {
    font-size: 2rem;
    font-weight: 900;
    color: white;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-download-text {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 30px;
    line-height: 1.6;
}

.tcs-download-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
}

.tcs-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 30px;
    background: white;
    color: #2C1810;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
}

.tcs-download-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
}

.tcs-download-btn svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-size-guide-title {
        font-size: 2.5rem;
    }
    
    .tcs-measurement-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }
}

@media (max-width: 768px) {
    .tcs-size-guide {
        padding: 60px 0;
    }
    
    .tcs-size-guide-title {
        font-size: 2rem;
    }
    
    .tcs-size-chart-wrapper,
    .tcs-measurement-section,
    .tcs-comparison-section,
    .tcs-download-section {
        padding: 30px 25px;
    }
    
    .tcs-size-table {
        font-size: 0.85rem;
    }
    
    .tcs-size-table th,
    .tcs-size-table td {
        padding: 12px 10px;
    }
    
    .tcs-compatibility-grid {
        grid-template-columns: 1fr;
    }
    
    .tcs-comparison-visual {
        flex-wrap: wrap;
        gap: 20px;
    }
    
    .tcs-download-buttons {
        flex-direction: column;
    }
    
    .tcs-download-btn {
        width: 100%;
        justify-content: center;
    }
}

@media (max-width: 480px) {
    .tcs-size-guide-title {
        font-size: 1.75rem;
    }
    
    .tcs-fitting-section {
        grid-template-columns: 1fr;
    }
}
</style>

