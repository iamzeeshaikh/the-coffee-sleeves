<style is:global>
/* Size Guide Section */
.tcs-size-guide {
    position: relative;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFF8F0 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Background Decoration */
.tcs-size-guide::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 25% 15%, rgba(255, 140, 66, 0.04) 0%, transparent 50%),
        radial-gradient(circle at 75% 85%, rgba(210, 105, 30, 0.04) 0%, transparent 50%);
    animation: bgDrift 25s ease-in-out infinite;
}

@keyframes bgDrift {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
}

.tcs-size-guide-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Section Header */
.tcs-size-guide-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tcs-size-guide-badge {
    display: inline-block;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
}

.tcs-size-guide-title {
    font-size: 3rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
}

.tcs-size-guide-subtitle {
    font-size: 1.2rem;
    color: #666666;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Size Chart Table */
.tcs-size-chart-wrapper {
    background: white;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    margin-bottom: 50px;
    animation: fadeInScale 0.8s ease-out 0.2s backwards;
    perspective: 1500px;
}

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.95) translateY(20px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.tcs-size-chart-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #2C1810;
    margin-bottom: 25px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    display: flex;
    align-items: center;
    gap: 12px;
}

.tcs-size-chart-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
}

.tcs-size-chart-icon svg {
    width: 22px;
    height: 22px;
    fill: white;
}

.tcs-size-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border-radius: 12px;
}

.tcs-size-table thead {
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
}

.tcs-size-table th {
    padding: 18px 15px;
    text-align: left;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
}

.tcs-size-table tbody tr {
    background: white;
    transition: all 0.3s ease;
    cursor: pointer;
}

.tcs-size-table tbody tr:hover {
    background: rgba(255, 140, 66, 0.05);
    transform: scale(1.02);
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.2);
}

.tcs-size-table tbody tr:nth-child(even) {
    background: rgba(0, 0, 0, 0.02);
}

.tcs-size-table tbody tr:nth-child(even):hover {
    background: rgba(255, 140, 66, 0.05);
}

.tcs-size-table td {
    padding: 16px 15px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    font-size: 0.95rem;
}

.tcs-size-name {
    font-weight: 700;
    color: #2C1810;
    font-size: 1.05rem;
}

.tcs-size-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    margin-left: 8px;
}

.tcs-size-badge.popular {
    background: rgba(255, 140, 66, 0.15);
    color: #D2691E;
}

.tcs-size-badge.eco {
    background: rgba(76, 175, 80, 0.15);
    color: #2E7D32;
}

/* Compatibility Grid */
.tcs-compatibility-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
}

.tcs-compatibility-card {
    background: white;
    border-radius: 20px;
    padding: 35px 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 2px solid transparent;
    perspective: 1000px;
    animation: fadeInUp 0.6s ease-out backwards;
}

.tcs-compatibility-card:nth-child(1) { animation-delay: 0.1s; }
.tcs-compatibility-card:nth-child(2) { animation-delay: 0.2s; }
.tcs-compatibility-card:nth-child(3) { animation-delay: 0.3s; }
.tcs-compatibility-card:nth-child(4) { animation-delay: 0.4s; }

.tcs-compatibility-card:hover {
    transform: translateY(-10px) rotateX(5deg);
    box-shadow: 0 20px 50px rgba(255, 140, 66, 0.2);
    border-color: rgba(255, 140, 66, 0.3);
}

.tcs-compatibility-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.tcs-compatibility-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    box-shadow: 0 8px 20px rgba(255, 140, 66, 0.4);
    transition: all 0.3s ease;
}

.tcs-compatibility-card:hover .tcs-compatibility-icon {
    transform: scale(1.1) rotateY(15deg);
}

.tcs-compatibility-name {
    font-size: 1.3rem;
    font-weight: 800;
    color: #2C1810;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-compatibility-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.tcs-compatibility-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    font-size: 0.95rem;
    color: #666666;
}

.tcs-compatibility-item:last-child {
    border-bottom: none;
}

.tcs-check-icon {
    width: 20px;
    height: 20px;
    background: #4CAF50;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tcs-check-icon::after {
    content: '✓';
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
}

/* Measurement Diagram */
.tcs-measurement-section {
    background: linear-gradient(135deg, #2C1810, #3E2723);
    border-radius: 20px;
    padding: 50px 40px;
    margin-bottom: 50px;
    color: white;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3);
    animation: fadeInScale 0.8s ease-out 0.4s backwards;
}

.tcs-measurement-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
}

.tcs-measurement-content h3 {
    font-size: 2rem;
    font-weight: 900;
    margin-bottom: 20px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-measurement-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.tcs-measurement-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 15px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.tcs-measurement-item:last-child {
    border-bottom: none;
}

.tcs-measurement-label {
    width: 40px;
    height: 40px;
    background: rgba(255, 140, 66, 0.2);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: #FF8C42;
    flex-shrink: 0;
}

.tcs-measurement-text {
    flex: 1;
}

.tcs-measurement-text strong {
    display: block;
    font-size: 1.1rem;
    margin-bottom: 5px;
    color: #FF8C42;
}

.tcs-measurement-text span {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
}

.tcs-measurement-diagram {
    background: white;
    border-radius: 15px;
    padding: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.tcs-diagram-sleeve {
    width: 200px;
    height: 280px;
    background: linear-gradient(135deg, #D2691E, #8B4513);
    border-radius: 15px;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.tcs-measurement-section:hover .tcs-diagram-sleeve {
    transform: rotateY(15deg);
}

.tcs-diagram-logo {
    font-size: 1.2rem;
    font-weight: 900;
    color: white;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
}

/* Measurement lines */
.tcs-diagram-line {
    position: absolute;
    background: #FF8C42;
    z-index: 10;
}

.tcs-diagram-line-h {
    height: 2px;
    width: 100%;
    top: 50%;
    left: 0;
}

.tcs-diagram-line-v {
    width: 2px;
    height: 100%;
    left: 50%;
    top: 0;
}

.tcs-diagram-label {
    position: absolute;
    background: #FF8C42;
    color: white;
    padding: 4px 10px;
    border-radius: 5px;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
}

.tcs-label-width {
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%);
}

.tcs-label-height {
    right: -50px;
    top: 50%;
    transform: translateY(-50%);
}

/* Fitting Instructions */
.tcs-fitting-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
    margin-bottom: 50px;
}

.tcs-fitting-card {
    background: white;
    border-radius: 15px;
    padding: 30px 25px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    text-align: center;
    transition: all 0.3s ease;
    animation: fadeInUp 0.6s ease-out backwards;
}

.tcs-fitting-card:nth-child(1) { animation-delay: 0.1s; }
.tcs-fitting-card:nth-child(2) { animation-delay: 0.2s; }
.tcs-fitting-card:nth-child(3) { animation-delay: 0.3s; }
.tcs-fitting-card:nth-child(4) { animation-delay: 0.4s; }

.tcs-fitting-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(255, 140, 66, 0.2);
}

.tcs-fitting-number {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 900;
    color: white;
    margin-bottom: 15px;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
}

.tcs-fitting-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #2C1810;
    margin-bottom: 10px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-fitting-desc {
    font-size: 0.9rem;
    color: #666666;
    line-height: 1.6;
}

/* Size Comparison */
.tcs-comparison-section {
    background: white;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    margin-bottom: 50px;
    animation: fadeInScale 0.8s ease-out 0.6s backwards;
}

.tcs-comparison-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #2C1810;
    margin-bottom: 30px;
    text-align: center;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-comparison-visual {
    display: flex;
