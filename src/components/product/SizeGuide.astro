<script is:inline>
(function() {
    'use strict';
    
    // Download template handlers
    function initDownloadButtons() {
        const downloadAI = document.getElementById('tcsDownloadAI');
        const downloadPDF = document.getElementById('tcsDownloadPDF');
        
        if (downloadAI) {
            downloadAI.addEventListener('click', function(e) {
                e.preventDefault();
                // Replace with actual file path
                window.location.href = '/wp-content/uploads/templates/coffee-sleeve-template.ai';
            });
        }
        
        if (downloadPDF) {
            downloadPDF.addEventListener('click', function(e) {
                e.preventDefault();
                // Replace with actual file path
                window.location.href = '/wp-content/uploads/templates/coffee-sleeve-size-guide.pdf';
            });
        }
    }
    
    // Table row hover effect
    function initTableInteraction() {
        const tableRows = document.querySelectorAll('.tcs-size-table tbody tr');
        
        tableRows.forEach(row => {
            row.addEventListener('click', function() {
                // Optional: scroll to customization section with this size selected
                console.log('Size selected:', this.querySelector('.tcs-size-name').textContent.trim());
            });
        });
    }
    
    // Size comparison interaction
    function initSizeComparison() {
        const comparisonCups = document.querySelectorAll('.tcs-comparison-cup');
        
        comparisonCups.forEach(cup => {
            cup.addEventListener('click', function() {
                const size = this.querySelector('.tcs-cup-label').textContent;
                console.log('Comparison size clicked:', size);
                // Optional: highlight in size table
            });
        });
    }
    
    // Animate measurements on scroll
    function initMeasurementAnimation() {
        const measurementSection = document.querySelector('.tcs-measurement-section');
        
        const observerOptions = {
            threshold: 0.3,
            rootMargin: '0px 0px -100px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const diagram = entry.target.querySelector('.tcs-diagram-sleeve');
                    if (diagram) {
                        diagram.style.animation = 'pulse 1s ease';
                        setTimeout(() => {
                            diagram.style.animation = '';
                        }, 1000);
                    }
                }
            });
        }, observerOptions);
        
        if (measurementSection) {
            observer.observe(measurementSection);
        }
    }
    
    // Pulse animation
    const style = document.createElement('style');
    style.textContent = `
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
    `;
    document.head.appendChild(style);
    
    // Initialize
    function init() {
        initDownloadButtons();
        initTableInteraction();
        initSizeComparison();
        initMeasurementAnimation();
        
        console.log('The Coffee Sleeves Size Guide - Initialized');
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
})();
</script>
