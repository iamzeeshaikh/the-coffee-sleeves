<style is:global>
/* Bulk Order CTA Section */
.tcs-bulk-order {
    position: relative;
    background: linear-gradient(135deg, #1A237E 0%, #283593 50%, #3F51B5 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Animated Background */
.tcs-bulk-order::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
    animation: bgPulse 15s ease-in-out infinite;
}

@keyframes bgPulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
}

/* Geometric Shapes Background */
.tcs-bulk-order::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><rect x="10" y="10" width="30" height="30" fill="rgba(255,255,255,0.03)"/><circle cx="70" cy="70" r="15" fill="rgba(255,255,255,0.03)"/></svg>');
    animation: bgMove 30s linear infinite;
}

@keyframes bgMove {
    from { transform: translateX(0); }
    to { transform: translateX(100px); }
}

.tcs-bulk-order-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Section Header */
.tcs-bulk-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tcs-bulk-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255, 255, 255, 0.3);
}

.tcs-bulk-title {
    font-size: 3rem;
    font-weight: 900;
    color: white;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
    text-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
}

.tcs-bulk-subtitle {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Main Content Grid */
.tcs-bulk-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 60px;
}

/* Volume Discount Card */
.tcs-discount-card {
    background: white;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: fadeInLeft 0.8s ease-out 0.2s backwards;
}

@keyframes fadeInLeft {
    from {
        opacity: 0;
        transform: translateX(-50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.tcs-discount-header {
    text-align: center;
    margin-bottom: 30px;
}

.tcs-discount-icon {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, #1A237E, #3F51B5);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 10px 30px rgba(26, 35, 126, 0.4);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

.tcs-discount-icon svg {
    width: 32px;
    height: 32px;
    fill: white;
}

.tcs-discount-title {
    font-size: 1.8rem;
    font-weight: 900;
    color: #1A237E;
    margin-bottom: 10px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-discount-desc {
    font-size: 1rem;
    color: #666666;
    line-height: 1.6;
}

/* Discount Tiers Table */
.tcs-discount-tiers {
    margin-top: 30px;
}

.tcs-tier-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 15px;
    padding: 20px;
    border-bottom: 2px solid rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    align-items: center;
}

.tcs-tier-row:first-child {
    background: linear-gradient(135deg, #1A237E, #3F51B5);
    color: white;
    border-radius: 12px;
    font-weight: 700;
    border: none;
}

.tcs-tier-row:not(:first-child):hover {
    background: rgba(26, 35, 126, 0.05);
    transform: translateX(10px);
    border-left: 4px solid #3F51B5;
}

.tcs-tier-quantity {
    font-weight: 700;
    color: #1A237E;
}

.tcs-tier-row:first-child .tcs-tier-quantity,
.tcs-tier-row:first-child .tcs-tier-discount,
.tcs-tier-row:first-child .tcs-tier-savings {
    color: white;
}

.tcs-tier-discount {
    font-size: 1.2rem;
    font-weight: 900;
    color: #4CAF50;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-tier-savings {
    font-size: 0.9rem;
    color: #666666;
    font-weight: 600;
}

/* Enterprise Solutions Card */
.tcs-enterprise-card {
    background: white;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: fadeInRight 0.8s ease-out 0.2s backwards;
}

@keyframes fadeInRight {
    from {
        opacity: 0;
        transform: translateX(50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.tcs-enterprise-header {
    text-align: center;
    margin-bottom: 30px;
}

.tcs-enterprise-icon {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, #FF6F00, #FF9800);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 10px 30px rgba(255, 111, 0, 0.4);
    animation: rotate 20s linear infinite;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.tcs-enterprise-icon svg {
    width: 32px;
    height: 32px;
    fill: white;
}

.tcs-enterprise-title {
    font-size: 1.8rem;
    font-weight: 900;
    color: #1A237E;
    margin-bottom: 10px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-enterprise-desc {
    font-size: 1rem;
    color: #666666;
    line-height: 1.6;
}

/* Enterprise Features */
.tcs-enterprise-features {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.tcs-enterprise-feature {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 15px;
    background: rgba(26, 35, 126, 0.05);
    border-radius: 12px;
    transition: all 0.3s ease;
    border-left: 4px solid transparent;
}

.tcs-enterprise-feature:hover {
    background: rgba(26, 35, 126, 0.1);
    border-left-color: #3F51B5;
    transform: translateX(5px);
}

.tcs-feature-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #1A237E, #3F51B5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tcs-feature-icon svg {
    width: 20px;
    height: 20px;
    fill: white;
}

.tcs-feature-content h4 {
    font-size: 1rem;
    font-weight: 700;
    color: #1A237E;
    margin-bottom: 5px;
}

.tcs-feature-content p {
    font-size: 0.9rem;
    color: #666666;
    line-height: 1.5;
    margin: 0;
}

/* Benefits Grid */
.tcs-bulk-benefits {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 50px 40px;
    margin-bottom: 60px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    animation: fadeInUp 0.8s ease-out 0.4s backwards;
}

.tcs-benefits-title {
    font-size: 2rem;
    font-weight: 900;
    color: white;
    text-align: center;
    margin-bottom: 40px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    text-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
}

.tcs-benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.tcs-benefit-item {
    text-align: center;
    padding: 25px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    transition: all 0.3s ease;
    border: 2px solid transparent;
    perspective: 1000px;
}

.tcs-benefit-item:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-10px) scale(1.05);
}

.tcs-benefit-icon {
    width: 60px;
    height: 60px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    transition: all 0.3s ease;
}

.tcs-benefit-item:hover .tcs-benefit-icon {
    transform: rotateY(180deg) scale(1.1);
}

.tcs-benefit-icon svg {
    width: 28px;
    height: 28px;
    fill: white;
}

.tcs-benefit-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    margin-bottom: 10px;
}

.tcs-benefit-desc {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
}

/* Contact Form Section */
.tcs-bulk-contact {
    background: white;
    border-radius: 20px;
    padding: 50px 40px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: fadeInScale 0.8s ease-out 0.6s backwards;
}

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.tcs-contact-header {
    text-align: center;
    margin-bottom: 40px;
}

.tcs-contact-title {
    font-size: 2rem;
    font-weight: 900;
    color: #1A237E;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-contact-subtitle {
    font-size: 1.1rem;
    color: #666666;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Form Grid */
.tcs-contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.tcs-form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.tcs-form-group.full-width {
    grid-column: 1 / -1;
}

.tcs-form-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1A237E;
}

.tcs-form-input,
.tcs-form-textarea,
.tcs-form-select {
    padding: 15px 20px;
    border: 2px solid rgba(26, 35, 126, 0.2);
    border-radius: 12px;
    font-size: 1rem;
    transition: all 0.3s ease;
    background: white;
    font-family: inherit;
}

.tcs-form-input:focus,
.tcs-form-textarea:focus,
.tcs-form-select:focus {
    outline: none;
    border-color: #3F51B5;
    box-shadow: 0 5px 15px rgba(63, 81, 181, 0.2);
}

.tcs-form-textarea {
    min-height: 120px;
    resize: vertical;
}

/* Response Time Guarantee */
.tcs-response-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin: 30px 0;
    padding: 20px;
    background: rgba(76, 175, 80, 0.1);
    border-radius: 12px;
    border: 2px solid rgba(76, 175, 80, 0.3);
}

.tcs-guarantee-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #4CAF50, #388E3C);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
}

.tcs-guarantee-icon svg {
    width: 18px;
    height: 18px;
    fill: white;
}

.tcs-guarantee-text {
    font-size: 1.1rem;
    font-weight: 700;
    color: #2E7D32;
}

/* Submit Button */
.tcs-submit-button {
    padding: 18px 50px;
    background: linear-gradient(135deg, #1A237E, #3F51B5);
    color: white;
    border: none;
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(26, 35, 126, 0.5);
    font-family: 'Impact', 'Arial Black', sans-serif;
    width: 100%;
}

.tcs-submit-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(26, 35, 126, 0.7);
}

.tcs-submit-button:active {
    transform: translateY(-2px);
}

/* Contact Info */
.tcs-contact-info {
    margin-top: 30px;
    text-align: center;
    padding-top: 30px;
    border-top: 2px solid rgba(0, 0, 0, 0.1);
}

.tcs-contact-methods {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
}

.tcs-contact-method {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #1A237E;
    font-weight: 600;
}

.tcs-contact-method svg {
    width: 24px;
    height: 24px;
    fill: #3F51B5;
}

/* Stats Bar */
.tcs-stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    margin-top: 60px;
    padding: 40px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    animation: fadeInUp 0.8s ease-out 0.8s backwards;
}

.tcs-stat-item {
    text-align: center;
}

.tcs-stat-value {
    font-size: 3rem;
    font-weight: 900;
    color: white;
    font-family: 'Impact', 'Arial Black', sans-serif;
    text-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
}

.tcs-stat-item:hover .tcs-stat-value {
    transform: scale(1.15);
}

.tcs-stat-label {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 600;
    margin-top: 10px;
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-bulk-title {
        font-size: 2.5rem;
    }
    
    .tcs-bulk-content {
        gap: 30px;
    }
    
    .tcs-tier-row {
        grid-template-columns: 2fr 1fr 1fr;
        gap: 10px;
        padding: 15px;
    }
}

@media (max-width: 768px) {
    .tcs-bulk-order {
        padding: 60px 0;
    }
    
    .tcs-bulk-title {
        font-size: 2rem;
    }
    
    .tcs-bulk-subtitle {
        font-size: 1rem;
    }
    
    .tcs-bulk-content {
        grid-template-columns: 1fr;
        gap: 30px;
    }
    
    .tcs-discount-card,
    .tcs-enterprise-card {
        padding: 30px 20px;
    }
    
    .tcs-tier-row {
        grid-template-columns: 1fr;
        gap: 10px;
        text-align: center;
    }
    
    .tcs-bulk-benefits {
        padding: 40px 25px;
    }
    
    .tcs-benefits-grid {
        grid-template-columns: 1fr;
    }
    
    .tcs-bulk-contact {
        padding: 40px 25px;
    }
    
    .tcs-contact-form {
        grid-template-columns: 1fr;
    }
    
    .tcs-contact-methods {
        flex-direction: column;
        gap: 20px;
    }
    
    .tcs-stats-bar {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .tcs-bulk-title {
        font-size: 1.75rem;
    }
    
    .tcs-stat-value {
        font-size: 2.5rem;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-discount-icon,
    .tcs-enterprise-icon,
    .tcs-guarantee-icon,
    .tcs-bulk-order::before,
    .tcs-bulk-order::after {
        animation: none !important;
    }
}


/* FIX: force both items to take full row in the form grid */
#tcsBulkOrderForm .tcs-response-guarantee{
  grid-column: 1 / -1 !important;   /* full width row */
  align-self: start !important;
}

#tcsBulkOrderForm .tcs-submit-button{
  grid-column: 1 / -1 !important;   /* full width row */
  align-self: start !important;
  justify-self: center !important;  /* if width auto */
}

/* Optional: stop grid from stretching items vertically */
#tcsBulkOrderForm.tcs-contact-form{
  align-items: start !important;
}

#tcsBulkOrderForm .tcs-submit-button{
  padding: 12px 22px !important;
  font-size: 15px !important;
  line-height: 1.1 !important;
  border-radius: 18px !important;
  min-height: 0 !important;
  height: auto !important;
  width: auto !important;  /* agar full width nahi chahiye */
}


</style>

