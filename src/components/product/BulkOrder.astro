<script is:inline>
(function() {
    'use strict';
    
    // Form submission handler
    function initFormSubmission() {
        const form = document.getElementById('tcsBulkOrderForm');
        
        if (form) {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(form);
                const submitBtn = form.querySelector('[type="submit"]');
                if (submitBtn) submitBtn.disabled = true;
                try {
                    const res = await fetch('/api/quote/', { method: 'POST', body: formData });
                    const data = await res.json().catch(function() { return {}; });
                    if (res.ok && data.success) {
                        alert('Thank you! Your quote request has been received. Our team will contact you within 24 hours.');
                        form.reset();
                    } else {
                        alert(data.message || 'Sorry, your request could not be sent. Please call (503) 358-0443 or email info@thecoffeesleeves.com.');
                    }
                } catch (err) {
                    alert('Network error - please try again, or email info@thecoffeesleeves.com.');
                } finally {
                    if (submitBtn) submitBtn.disabled = false;
                }
            });
        }
    }
    
    // Animate stats on scroll
    function initStatsAnimation() {
        const stats = document.querySelectorAll('.tcs-stat-value');
        
        const observerOptions = {
            threshold: 0.5
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const stat = entry.target;
                    const text = stat.textContent;
                    
                    // Animate only numeric stats
                    if (text.match(/^\d+/)) {
                        const match = text.match(/^(\d+)(.*)$/);
                        if (match) {
                            const target = parseInt(match[1]);
                            const suffix = match[2];
                            let current = 0;
                            const increment = target / 30;
                            
                            const timer = setInterval(() => {
                                current += increment;
                                if (current >= target) {
                                    stat.textContent = target + suffix;
                                    clearInterval(timer);
                                } else {
                                    stat.textContent = Math.floor(current) + suffix;
                                }
                            }, 50);
                        }
                    }
                    
                    observer.unobserve(stat);
                }
            });
        }, observerOptions);
        
        stats.forEach(stat => {
            observer.observe(stat);
        });
    }
    
    // Highlight discount tiers on hover
    function initTierHighlight() {
        const rows = document.querySelectorAll('.tcs-tier-row:not(:first-child)');
        
        rows.forEach(row => {
            row.addEventListener('mouseenter', function() {
                const discount = this.querySelector('.tcs-tier-discount');
                if (discount) {
                    discount.style.transform = 'scale(1.2)';
                }
            });
            
            row.addEventListener('mouseleave', function() {
                const discount = this.querySelector('.tcs-tier-discount');
                if (discount) {
                    discount.style.transform = '';
                }
            });
        });
    }
    
    // Initialize
    function init() {
        initFormSubmission();
        initStatsAnimation();
        initTierHighlight();
        
        console.log('The Coffee Sleeves Bulk Order - Initialized');
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
})();
</script>
