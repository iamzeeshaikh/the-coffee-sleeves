<script is:inline>
(function() {
    'use strict';
    
    // 3D Tilt Effect for Feature Cards
    function init3DTilt() {
        const featureCards = document.querySelectorAll('.tcs-feature-card-inner');
        
        featureCards.forEach(card => {
            card.addEventListener('mousemove', function(e) {
                if (window.innerWidth <= 768) return;
                
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = (y - centerY) / 20;
                const rotateY = (centerX - x) / 20;
                
                card.style.transform = `translateY(-15px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            });
            
            card.addEventListener('mouseleave', function() {
                card.style.transform = '';
            });
        });
    }
    
    // Icon Animation on Scroll
    function initIconAnimation() {
        const cards = document.querySelectorAll('.tcs-feature-card');
        
        const observerOptions = {
            threshold: 0.3,
            rootMargin: '0px 0px -100px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const icon = entry.target.querySelector('.tcs-feature-icon');
                    if (icon) {
                        icon.style.animation = 'iconPulse 0.6s ease';
                        setTimeout(() => {
                            icon.style.animation = '';
                        }, 600);
                    }
                }
            });
        }, observerOptions);
        
        cards.forEach(card => {
            observer.observe(card);
        });
    }
    
    // Why Choose Icons Animation
    function initWhyChooseAnimation() {
        const whyChooseIcons = document.querySelectorAll('.tcs-why-choose-icon');
        
        whyChooseIcons.forEach((icon, index) => {
            setTimeout(() => {
                icon.style.animation = 'iconPulse 0.6s ease';
            }, index * 150);
        });
    }
    
    // Scroll Animations
    function initScrollAnimations() {
        const cards = document.querySelectorAll('.tcs-feature-card');
        
        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animationPlayState = 'running';
                }
            });
        }, observerOptions);
        
        cards.forEach(card => {
            observer.observe(card);
        });
    }
    
    // Initialize
    function init() {
        if (window.innerWidth > 768) {
            init3DTilt();
        }
        
        initIconAnimation();
        initScrollAnimations();
        
        // Delay why choose animation
        setTimeout(() => {
            initWhyChooseAnimation();
        }, 1000);
        
        console.log('The Coffee Sleeves Product Features - Initialized');
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
})();
</script>
