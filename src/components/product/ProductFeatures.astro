<style is:global>
/* Key Features Section */
.tcs-product-features {
    position: relative;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFF8F0 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Background Decoration */
.tcs-product-features::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 15% 25%, rgba(255, 140, 66, 0.06) 0%, transparent 50%),
        radial-gradient(circle at 85% 75%, rgba(210, 105, 30, 0.06) 0%, transparent 50%);
    animation: bgFloat 20s ease-in-out infinite;
}

@keyframes bgFloat {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.05); }
}

.tcs-product-features-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Section Header */
.tcs-product-features-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tcs-product-features-badge {
    display: inline-block;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
}

.tcs-product-features-title {
    font-size: 3rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
}

.tcs-product-features-subtitle {
    font-size: 1.2rem;
    color: #666666;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Features Grid */
.tcs-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
}

/* Feature Card */
.tcs-feature-card {
    perspective: 1500px;
    animation: fadeInScale 0.8s ease-out forwards;
    opacity: 0;
}

.tcs-feature-card:nth-child(1) { animation-delay: 0.1s; }
.tcs-feature-card:nth-child(2) { animation-delay: 0.2s; }
.tcs-feature-card:nth-child(3) { animation-delay: 0.3s; }
.tcs-feature-card:nth-child(4) { animation-delay: 0.4s; }
.tcs-feature-card:nth-child(5) { animation-delay: 0.5s; }
.tcs-feature-card:nth-child(6) { animation-delay: 0.6s; }
.tcs-feature-card:nth-child(7) { animation-delay: 0.7s; }
.tcs-feature-card:nth-child(8) { animation-delay: 0.8s; }

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: translateY(30px) scale(0.9);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.tcs-feature-card-inner {
    position: relative;
    background: white;
    border-radius: 20px;
    padding: 35px 30px;
    height: 100%;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    border: 2px solid transparent;
    overflow: hidden;
}

.tcs-feature-card:hover .tcs-feature-card-inner {
    transform: translateY(-15px) rotateX(8deg);
    box-shadow: 
        0 25px 50px rgba(0, 0, 0, 0.15),
        0 0 40px rgba(255, 140, 66, 0.2);
    border-color: rgba(255, 140, 66, 0.3);
}

/* Gradient Background on Hover */
.tcs-feature-card-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.05), rgba(210, 105, 30, 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 20px;
}

.tcs-feature-card:hover .tcs-feature-card-inner::before {
    opacity: 1;
}

/* Feature Content */
.tcs-feature-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

/* Feature Icon */
.tcs-feature-icon-wrapper {
    position: relative;
    width: 90px;
    height: 90px;
    margin-bottom: 25px;
    perspective: 1000px;
}

.tcs-feature-icon {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
        0 10px 30px rgba(255, 140, 66, 0.4),
        inset 0 -5px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    position: relative;
}

/* Glow Effect */
.tcs-feature-icon::before {
    content: '';
    position: absolute;
    top: -8px;
    left: -8px;
    right: -8px;
    bottom: -8px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 20px;
    opacity: 0.5;
    filter: blur(20px);
    z-index: -1;
    transition: all 0.3s ease;
}

.tcs-feature-card:hover .tcs-feature-icon {
    transform: translateZ(40px) rotateY(15deg) scale(1.1);
    animation: iconPulse 0.6s ease;
}

.tcs-feature-card:hover .tcs-feature-icon::before {
    opacity: 0.8;
    filter: blur(25px);
}

@keyframes iconPulse {
    0%, 100% { transform: translateZ(40px) rotateY(15deg) scale(1.1); }
    50% { transform: translateZ(50px) rotateY(20deg) scale(1.15); }
}

.tcs-feature-icon svg {
    width: 45px;
    height: 45px;
    fill: white;
}

/* Feature Title */
.tcs-feature-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #2C1810;
    margin-bottom: 12px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    transition: color 0.3s ease;
}

.tcs-feature-card:hover .tcs-feature-title {
    color: #FF8C42;
}

/* Feature Description */
.tcs-feature-description {
    font-size: 0.95rem;
    color: #666666;
    line-height: 1.7;
    transition: color 0.3s ease;
}

.tcs-feature-card:hover .tcs-feature-description {
    color: #2C1810;
}

/* Feature Badge (Optional) */
.tcs-feature-badge {
    display: inline-block;
    background: rgba(255, 140, 66, 0.1);
    color: #FF8C42;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-top: 12px;
    letter-spacing: 0.5px;
}

/* Shine Effect */
.tcs-feature-card-inner::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
        45deg,
        transparent,
        rgba(255, 255, 255, 0.3),
        transparent
    );
    transform: rotate(45deg);
    transition: all 0.5s ease;
    opacity: 0;
}

.tcs-feature-card:hover .tcs-feature-card-inner::after {
    opacity: 1;
    animation: shine 0.8s ease;
}

@keyframes shine {
    from { left: -50%; }
    to { left: 150%; }
}

/* Why Choose Section */
.tcs-why-choose {
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.08), rgba(210, 105, 30, 0.08));
    border-radius: 20px;
    padding: 50px 40px;
    text-align: center;
    border: 2px solid rgba(255, 140, 66, 0.2);
    animation: fadeInUp 1s ease-out 0.9s backwards;
}

.tcs-why-choose-title {
    font-size: 2rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 20px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-why-choose-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    margin-top: 30px;
}

.tcs-why-choose-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

.tcs-why-choose-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
    transition: all 0.3s ease;
}

.tcs-why-choose-item:hover .tcs-why-choose-icon {
    transform: scale(1.15) rotateY(180deg);
}

.tcs-why-choose-icon svg {
    width: 30px;
    height: 30px;
    fill: white;
}

.tcs-why-choose-text {
    font-size: 1rem;
    font-weight: 700;
    color: #2C1810;
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-product-features-title {
        font-size: 2.5rem;
    }
    
    .tcs-features-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }
}

@media (max-width: 768px) {
    .tcs-product-features {
        padding: 60px 0;
    }
    
    .tcs-product-features-header {
        margin-bottom: 50px;
    }
    
    .tcs-product-features-title {
        font-size: 2rem;
    }
    
    .tcs-product-features-subtitle {
        font-size: 1rem;
    }
    
    .tcs-features-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    .tcs-why-choose {
        padding: 40px 25px;
    }
    
    .tcs-why-choose-title {
        font-size: 1.6rem;
    }
    
    .tcs-why-choose-content {
        grid-template-columns: 1fr;
        gap: 20px;
    }
}

@media (max-width: 480px) {
    .tcs-product-features-title {
        font-size: 1.75rem;
    }
    
    .tcs-feature-card-inner {
        padding: 30px 25px;
    }
    
    .tcs-feature-icon-wrapper {
        width: 75px;
        height: 75px;
    }
    
    .tcs-feature-icon svg {
        width: 38px;
        height: 38px;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-feature-card,
    .tcs-product-features-header,
    .tcs-feature-icon,
    .tcs-product-features::before,
    .tcs-why-choose {
        animation: none !important;
    }
}
</style>

