<style is:global>
/* Design Templates Section */
.tcs-design-templates {
    position: relative;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFF8F0 50%, #FFFFFF 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Background Decoration */
.tcs-design-templates::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 20% 30%, rgba(255, 140, 66, 0.04) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(156, 39, 176, 0.04) 0%, transparent 50%);
    animation: bgSwirl 30s ease-in-out infinite;
}

@keyframes bgSwirl {
    0%, 100% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(10deg) scale(1.1); }
}

.tcs-design-templates-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Section Header */
.tcs-templates-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tcs-templates-badge {
    display: inline-block;
    background: linear-gradient(135deg, #9C27B0, #673AB7);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 5px 15px rgba(156, 39, 176, 0.4);
}

.tcs-templates-title {
    font-size: 3rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
}

.tcs-templates-subtitle {
    font-size: 1.2rem;
    color: #666666;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Filter Tabs */
.tcs-filter-tabs {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 50px;
    flex-wrap: wrap;
    animation: fadeInUp 0.8s ease-out 0.2s backwards;
}

.tcs-filter-tab {
    padding: 12px 30px;
    background: white;
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #2C1810;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
}

.tcs-filter-tab:hover {
    border-color: #9C27B0;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(156, 39, 176, 0.2);
}

.tcs-filter-tab.active {
    background: linear-gradient(135deg, #9C27B0, #673AB7);
    color: white;
    border-color: transparent;
    box-shadow: 0 8px 25px rgba(156, 39, 176, 0.4);
}

/* Templates Grid */
.tcs-templates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
}

/* Template Card */
.tcs-template-card {
    perspective: 1500px;
    animation: fadeInScale 0.8s ease-out backwards;
}

.tcs-template-card:nth-child(1) { animation-delay: 0.1s; }
.tcs-template-card:nth-child(2) { animation-delay: 0.2s; }
.tcs-template-card:nth-child(3) { animation-delay: 0.3s; }
.tcs-template-card:nth-child(4) { animation-delay: 0.4s; }
.tcs-template-card:nth-child(5) { animation-delay: 0.5s; }
.tcs-template-card:nth-child(6) { animation-delay: 0.6s; }
.tcs-template-card:nth-child(7) { animation-delay: 0.7s; }
.tcs-template-card:nth-child(8) { animation-delay: 0.8s; }

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.9);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.tcs-template-inner {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 3px solid transparent;
    cursor: pointer;
    transform-style: preserve-3d;
    position: relative;
}

.tcs-template-card:hover .tcs-template-inner {
    transform: translateY(-15px) rotateY(5deg) scale(1.03);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15);
    border-color: rgba(156, 39, 176, 0.3);
}

/* Template Image */
.tcs-template-image {
    width: 100%;
    height: 250px;
    background: linear-gradient(135deg, #E1BEE7, #CE93D8);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
    position: relative;
    overflow: hidden;
}

/* Placeholder for actual images - replace with <img> tags */
.tcs-template-image::after {
    content: attr(data-emoji);
    font-size: 4rem;
}

.tcs-template-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.5s ease;
}

.tcs-template-card:hover .tcs-template-image img {
    transform: scale(1.1);
}

/* Template Overlay */
.tcs-template-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(156, 39, 176, 0.9), rgba(103, 58, 183, 0.9));
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.3s ease;
    flex-direction: column;
    gap: 15px;
}

.tcs-template-card:hover .tcs-template-overlay {
    opacity: 1;
}

.tcs-template-action {
    padding: 12px 25px;
    background: white;
    color: #9C27B0;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}

.tcs-template-action:hover {
    transform: scale(1.1);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
}

/* Template Info */
.tcs-template-info {
    padding: 25px;
}

.tcs-template-category {
    display: inline-block;
    padding: 5px 12px;
    background: rgba(156, 39, 176, 0.1);
    color: #9C27B0;
    border-radius: 15px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 10px;
}

.tcs-template-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #2C1810;
    margin-bottom: 8px;
}

.tcs-template-description {
    font-size: 0.9rem;
    color: #666666;
    line-height: 1.6;
}

/* Before/After Section */
.tcs-before-after-section {
    background: white;
    border-radius: 20px;
    padding: 50px 40px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out 0.9s backwards;
}

.tcs-before-after-title {
    font-size: 2rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 40px;
    text-align: center;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-before-after-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
}

/* Before/After Card */
.tcs-ba-card {
    position: relative;
    perspective: 1500px;
}

.tcs-ba-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: center;
}

.tcs-ba-item {
    text-align: center;
}

.tcs-ba-label {
    display: inline-block;
    padding: 8px 20px;
    background: linear-gradient(135deg, #9C27B0, #673AB7);
    color: white;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 15px;
    text-transform: uppercase;
}

.tcs-ba-image {
    width: 100%;
    height: 200px;
    background: linear-gradient(135deg, #E0E0E0, #BDBDBD);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
}

.tcs-ba-card:hover .tcs-ba-image {
    transform: scale(1.05);
}

.tcs-ba-arrow {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #9C27B0, #673AB7);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
    font-weight: 700;
    box-shadow: 0 10px 30px rgba(156, 39, 176, 0.5);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50% { transform: translate(-50%, -50%) scale(1.1); }
}

/* Industry Examples */
.tcs-industry-examples {
    margin-bottom: 60px;
}

.tcs-industry-title {
    font-size: 2rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 40px;
    text-align: center;
    font-family: 'Impact', 'Arial Black', sans-serif;
    animation: fadeInUp 0.8s ease-out 1s backwards;
}

.tcs-industry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.tcs-industry-card {
    background: white;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    text-align: center;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
    border: 3px solid transparent;
    animation: fadeInScale 0.8s ease-out backwards;
}

.tcs-industry-card:nth-child(1) { animation-delay: 1.1s; }
.tcs-industry-card:nth-child(2) { animation-delay: 1.2s; }
.tcs-industry-card:nth-child(3) { animation-delay: 1.3s; }
.tcs-industry-card:nth-child(4) { animation-delay: 1.4s; }

.tcs-industry-card:hover {
    transform: translateY(-15px) scale(1.05);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15);
    border-color: rgba(156, 39, 176, 0.3);
}

.tcs-industry-icon {
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, rgba(156, 39, 176, 0.1), rgba(103, 58, 183, 0.1));
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    margin-bottom: 20px;
    transition: all 0.3s ease;
}

.tcs-industry-card:hover .tcs-industry-icon {
    background: linear-gradient(135deg, #9C27B0, #673AB7);
    transform: rotateY(180deg);
}

.tcs-industry-name {
    font-size: 1.3rem;
    font-weight: 700;
    color: #2C1810;
    margin-bottom: 10px;
}

.tcs-industry-desc {
    font-size: 0.9rem;
    color: #666666;
    line-height: 1.6;
    margin-bottom: 15px;
}

.tcs-industry-examples-list {
    font-size: 0.85rem;
    color: #9C27B0;
    font-weight: 600;
}

/* Free Design Service CTA */
.tcs-free-design-cta {
    background: linear-gradient(135deg, #9C27B0, #673AB7);
    border-radius: 20px;
    padding: 60px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
    animation: fadeInScale 0.8s ease-out 1.5s backwards;
}

.tcs-free-design-cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="40" fill="rgba(255,255,255,0.05)"/></svg>');
    animation: bgMove 20s linear infinite;
}

@keyframes bgMove {
    from { transform: translateX(0); }
    to { transform: translateX(100px); }
}

.tcs-cta-content {
    position: relative;
    z-index: 1;
}

.tcs-cta-icon {
    width: 120px;
    height: 120px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
}

.tcs-cta-icon svg {
    width: 60px;
    height: 60px;
    fill: white;
}

.tcs-cta-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: white;
    margin-bottom: 20px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-cta-subtitle {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 700px;
    margin: 0 auto 30px;
    line-height: 1.6;
}

.tcs-cta-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    max-width: 800px;
    margin: 0 auto 40px;
}

.tcs-cta-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
    font-weight: 600;
}

.tcs-cta-feature::before {
    content: '✓';
    width: 30px;
    height: 30px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tcs-cta-button {
    display: inline-block;
    padding: 18px 50px;
    background: white;
    color: #9C27B0;
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-cta-button:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-templates-title {
        font-size: 2.5rem;
    }
    
    .tcs-templates-grid {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    }
}

@media (max-width: 768px) {
    .tcs-design-templates {
        padding: 60px 0;
    }
    
    .tcs-templates-title {
        font-size: 2rem;
    }
    
    .tcs-templates-subtitle {
        font-size: 1rem;
    }
    
    .tcs-filter-tabs {
        gap: 10px;
    }
    
    .tcs-filter-tab {
        padding: 10px 20px;
        font-size: 0.85rem;
    }
    
    .tcs-templates-grid {
        grid-template-columns: 1fr;
    }
    
    .tcs-template-card:hover .tcs-template-inner {
        transform: translateY(-10px) scale(1.02);
    }
    
    .tcs-before-after-section {
        padding: 40px 25px;
    }
    
    .tcs-ba-container {
        grid-template-columns: 1fr;
        gap: 30px;
    }
    
    .tcs-ba-arrow {
        top: auto;
        bottom: -60px;
        transform: translate(-50%, 0) rotate(90deg);
    }
    
    .tcs-industry-grid {
        grid-template-columns: 1fr;
    }
    
    .tcs-free-design-cta {
        padding: 50px 25px;
    }
    
    .tcs-cta-title {
        font-size: 2rem;
    }
    
    .tcs-cta-features {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .tcs-templates-title {
        font-size: 1.75rem;
    }
    
    .tcs-template-image {
        height: 200px;
    }
    
    .tcs-cta-title {
        font-size: 1.75rem;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-template-card,
    .tcs-industry-card,
    .tcs-ba-arrow,
    .tcs-cta-icon,
    .tcs-design-templates::before {
        animation: none !important;
    }
}
</style>

