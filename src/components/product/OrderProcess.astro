<script is:inline>
(function() {
    'use strict';
    
    // Animate timeline line on scroll
    function initTimelineAnimation() {
        const timeline = document.querySelector('.tcs-timeline-line');
        
        if (!timeline) return;
        
        const observerOptions = {
            threshold: 0.3,
            rootMargin: '0px 0px -100px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    timeline.style.animationPlayState = 'running';
                }
            });
        }, observerOptions);
        
        observer.observe(timeline);
    }
    
    // Animate step cards on scroll
    function initStepAnimations() {
        const steps = document.querySelectorAll('.tcs-step-card');
        
        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animationPlayState = 'running';
                }
            });
        }, observerOptions);
        
        steps.forEach(step => {
            observer.observe(step);
        });
    }
    
    // 3D Tilt effect for step cards
    function init3DTilt() {
        const cards = document.querySelectorAll('.tcs-step-inner');
        
        cards.forEach(card => {
            card.addEventListener('mousemove', function(e) {
                if (window.innerWidth <= 768) return;
                
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = (y - centerY) / 20;
                const rotateY = (centerX - x) / 20;
                
                card.style.transform = `translateY(-20px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.05)`;
            });
            
            card.addEventListener('mouseleave', function() {
                card.style.transform = '';
            });
        });
    }
    
    // Smooth scroll to customization section
    function initCTAButton() {
        const ctaBtn = document.querySelector('.tcs-order-btn');
        
        if (ctaBtn) {
            ctaBtn.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                
                if (href && href.startsWith('#')) {
                    e.preventDefault();
                    const target = document.querySelector(href);
                    
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                }
            });
        }
    }
    
    // Highlight active step on scroll
    function initProgressTracking() {
        const steps = document.querySelectorAll('.tcs-step-card');
        
        const observerOptions = {
            threshold: 0.5
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // Add subtle pulse to icon
                    const icon = entry.target.querySelector('.tcs-step-icon');
                    if (icon) {
                        icon.style.animation = 'pulse 0.6s ease';
                        setTimeout(() => {
                            icon.style.animation = '';
                        }, 600);
                    }
                }
            });
        }, observerOptions);
        
        steps.forEach(step => {
            observer.observe(step);
        });
    }
    
    // Add pulse animation for icons
    function addPulseAnimation() {
        const style = document.createElement('style');
        style.textContent = `
            @keyframes pulse {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.1); }
            }
        `;
        document.head.appendChild(style);
    }
    
    // Initialize
    function init() {
        addPulseAnimation();
        initTimelineAnimation();
        initStepAnimations();
        
        if (window.innerWidth > 768) {
            init3DTilt();
        }
        
        initCTAButton();
        initProgressTracking();
        
        console.log('The Coffee Sleeves Order Process - Initialized');
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
})();
</script>
