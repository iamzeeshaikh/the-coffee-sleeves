    <script is:inline>
        (function() {
            'use strict';
            
            // FORM SUBMISSION CONFIGURATION
            // Choose one of these methods:
            
            // METHOD 1: PHP EMAIL (Most Common)
            // Set this to your PHP handler file:
            const PHP_HANDLER = '/api/quote/';
            
            // METHOD 2: Formspree (Easy, no coding)
            // Sign up at formspree.io and get your form ID
            const FORMSPREE_ID = 'YOUR_FORMSPREE_ID'; // Replace with your ID
            
            // METHOD 3: Custom API endpoint
            const CUSTOM_API = 'https://yoursite.com/api/quote';
            
            // Select which method to use:
            const SUBMISSION_METHOD = 'php'; // Options: 'php', 'formspree', 'custom'
            
            // Form submission handler
            function initFormSubmission() {
                const form = document.getElementById('tcsQuoteForm');
                
                if (form) {
                    form.addEventListener('submit', async function(e) {
                        e.preventDefault();
                        
                        // Disable submit button
                        const submitBtn = form.querySelector('.tcs-submit-btn');
                        const originalText = submitBtn.textContent;
                        submitBtn.disabled = true;
                        submitBtn.textContent = 'Sending...';
                        
                        // Get form data
                        const formData = new FormData(form);
                        
                        try {
                            let response;
                            
                            if (SUBMISSION_METHOD === 'php') {
                                // PHP Method
                                response = await fetch(PHP_HANDLER, {
                                    method: 'POST',
                                    body: formData
                                });
                            } else if (SUBMISSION_METHOD === 'formspree') {
                                // Formspree Method
                                response = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
                                    method: 'POST',
                                    body: formData,
                                    headers: {
                                        'Accept': 'application/json'
                                    }
                                });
                            } else if (SUBMISSION_METHOD === 'custom') {
                                // Custom API Method
                                response = await fetch(CUSTOM_API, {
                                    method: 'POST',
                                    body: formData
                                });
                            }
                            
                            if (response && response.ok) {
                                // Success
                                alert('Thank you! Your quote request has been received. We\'ll get back to you within 24 hours.');
                                form.reset();
                                
                                // Optional: Redirect to thank you page
                                // window.location.href = '/thank-you';
                            } else {
                                throw new Error('Submission failed');
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            alert('There was an error sending your request. Please call us at (503) 358-0443 or email info@thecoffeesleeves.com');
                        } finally {
                            // Re-enable button
                            submitBtn.disabled = false;
                            submitBtn.textContent = originalText;
                        }
                    });
                }
            }
            
            // File upload handler
            function initFileUpload() {
                const fileInput = document.querySelector('.tcs-file-upload input[type="file"]');
                const uploadArea = document.querySelector('.tcs-file-upload');
                
                if (fileInput && uploadArea) {
                    fileInput.addEventListener('change', function(e) {
                        const files = e.target.files;
                        if (files.length > 0) {
                            const fileNames = Array.from(files).map(f => f.name).join(', ');
                            uploadArea.querySelector('.tcs-upload-text').textContent = 
                                `${files.length} file(s) selected`;
                            uploadArea.querySelector('.tcs-upload-hint').textContent = fileNames;
                            console.log('Files uploaded:', fileNames);
                        }
                    });
                    
                    // Drag and drop
                    uploadArea.addEventListener('dragover', function(e) {
                        e.preventDefault();
                        this.style.borderColor = '#D2691E';
                        this.style.background = 'rgba(139, 69, 19, 0.1)';
                    });
                    
                    uploadArea.addEventListener('dragleave', function(e) {
                        e.preventDefault();
                        this.style.borderColor = '';
                        this.style.background = '';
                    });
                    
                    uploadArea.addEventListener('drop', function(e) {
                        e.preventDefault();
                        this.style.borderColor = '';
                        this.style.background = '';
                        
                        const files = e.dataTransfer.files;
                        fileInput.files = files;
                        
                        // Trigger change event
                        const event = new Event('change', { bubbles: true });
                        fileInput.dispatchEvent(event);
                    });
                }
            }
            
            // Form field animations
            function initFieldAnimations() {
                const inputs = document.querySelectorAll('.tcs-form-input, .tcs-form-textarea, .tcs-form-select');
                
                inputs.forEach(input => {
                    input.addEventListener('focus', function() {
                        this.parentElement.style.transform = 'translateX(5px)';
                    });
                    
                    input.addEventListener('blur', function() {
                        this.parentElement.style.transform = '';
                    });
                });
            }
            
            // Initialize
            function init() {
                initFormSubmission();
                initFileUpload();
                initFieldAnimations();
                
                console.log('The Coffee Sleeves Quote Page - Initialized');
            }
            
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
            
        })();
    </script>


