<style is:global>
/* Footer Section */
.tcs-footer {
    position: relative;
    background: linear-gradient(135deg, #2C1810 0%, #3E2723 100%);
    color: rgba(255, 255, 255, 0.8);
    overflow: hidden;
}

/* Animated Background */
.tcs-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 20% 30%, rgba(255, 140, 66, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(210, 105, 30, 0.08) 0%, transparent 50%);
    animation: bgPulse 15s ease-in-out infinite;
}

@keyframes bgPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
}

/* Newsletter Section */
.tcs-footer-newsletter {
    position: relative;
    padding: 60px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.tcs-footer-newsletter-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
}

.tcs-newsletter-content h3 {
    font-size: 2rem;
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: 10px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-newsletter-content p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
}

.tcs-newsletter-form {
    display: flex;
    gap: 15px;
    perspective: 1000px;
}

.tcs-newsletter-input {
    flex: 1;
    padding: 16px 20px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    color: white;
    font-size: 1rem;
    transition: all 0.3s ease;
}

.tcs-newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
}

.tcs-newsletter-input:focus {
    outline: none;
    border-color: #FF8C42;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.2);
    transform: translateY(-2px);
}

.tcs-newsletter-btn {
    padding: 16px 35px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
    white-space: nowrap;
}

.tcs-newsletter-btn:hover {
    background: linear-gradient(135deg, #D2691E, #8B4513);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(255, 140, 66, 0.6);
}

/* Main Footer */
.tcs-footer-main {
    position: relative;
    padding: 60px 0 40px;
    z-index: 2;
}

.tcs-footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.tcs-footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
}

/* Footer Column */
.tcs-footer-column {
    perspective: 1000px;
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
}

.tcs-footer-column:nth-child(1) { animation-delay: 0.1s; }
.tcs-footer-column:nth-child(2) { animation-delay: 0.2s; }
.tcs-footer-column:nth-child(3) { animation-delay: 0.3s; }
.tcs-footer-column:nth-child(4) { animation-delay: 0.4s; }

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Company Info Column */
.tcs-footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    transition: all 0.3s ease;
}

.tcs-footer-logo:hover {
    transform: translateX(5px);
}

.tcs-footer-logo-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
}

.tcs-footer-logo-text {
    font-size: 1.5rem;
    font-weight: 900;
    color: #FFFFFF;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-footer-description {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 25px;
    color: rgba(255, 255, 255, 0.7);
}

/* Social Media */
.tcs-footer-social {
    display: flex;
    gap: 12px;
}

.tcs-footer-social-link {
    width: 45px;
    height: 45px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 2px solid transparent;
}

.tcs-footer-social-link:hover {
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    border-color: rgba(255, 140, 66, 0.3);
    transform: translateY(-5px) rotateY(15deg);
    box-shadow: 0 8px 20px rgba(255, 140, 66, 0.4);
}

.tcs-footer-social-link svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
}

/* Column Title */
.tcs-footer-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 20px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    position: relative;
    padding-bottom: 12px;
}

.tcs-footer-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 3px;
    background: linear-gradient(90deg, #FF8C42, transparent);
}

/* Footer Links */
.tcs-footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.tcs-footer-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.tcs-footer-link::before {
    content: '→';
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
    color: #FF8C42;
}

.tcs-footer-link:hover {
    color: #FFFFFF;
    transform: translateX(5px);
}

.tcs-footer-link:hover::before {
    opacity: 1;
    transform: translateX(0);
}

/* Contact Info */
.tcs-footer-contact {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.tcs-footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    transition: all 0.3s ease;
}

.tcs-footer-contact-item:hover {
    color: #FFFFFF;
    transform: translateX(5px);
}

.tcs-footer-contact-icon {
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.tcs-footer-contact-item:hover .tcs-footer-contact-icon {
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    transform: scale(1.1) rotateY(15deg);
}

.tcs-footer-contact-icon svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
}

.tcs-footer-contact-text a {
    color: inherit;
    text-decoration: none;
}

.tcs-footer-contact-text a:hover {
    color: #FF8C42;
}

/* Bottom Bar */
.tcs-footer-bottom {
    position: relative;
    padding: 30px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.tcs-footer-bottom-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
}

.tcs-footer-copyright {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
}

.tcs-footer-copyright a {
    color: #FF8C42;
    text-decoration: none;
}

.tcs-footer-copyright a:hover {
    text-decoration: underline;
}

/* Payment Icons */
.tcs-footer-payments {
    display: flex;
    align-items: center;
    gap: 15px;
}

.tcs-footer-payments-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    font-weight: 600;
}

.tcs-footer-payment-icons {
    display: flex;
    gap: 10px;
}

.tcs-footer-payment-icon {
    width: 50px;
    height: 32px;
    background: white;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: #2C1810;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.tcs-footer-payment-icon:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.3);
}

/* Scroll to Top Button */
.tcs-footer-scroll-top {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 5px 20px rgba(255, 140, 66, 0.5);
    z-index: 1000;
}

.tcs-footer-scroll-top.show {
    opacity: 1;
    visibility: visible;
}

.tcs-footer-scroll-top:hover {
    transform: translateY(-5px) scale(1.1);
    box-shadow: 0 10px 30px rgba(255, 140, 66, 0.7);
}

.tcs-footer-scroll-top svg {
    width: 24px;
    height: 24px;
    fill: white;
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-footer-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .tcs-footer-newsletter-container {
        gap: 30px;
    }
}

@media (max-width: 768px) {
    .tcs-footer-newsletter {
        padding: 40px 0;
    }
    
    .tcs-footer-newsletter-container {
        grid-template-columns: 1fr;
        text-align: center;
    }
    
    .tcs-newsletter-form {
        flex-direction: column;
    }
    
    .tcs-newsletter-btn {
        width: 100%;
    }
    
    .tcs-footer-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }
    
    .tcs-footer-bottom-container {
        flex-direction: column;
        text-align: center;
    }
    
    .tcs-footer-payments {
        flex-direction: column;
        gap: 10px;
    }
    
    .tcs-footer-scroll-top {
        bottom: 20px;
        right: 20px;
    }
}

@media (max-width: 480px) {
    .tcs-newsletter-content h3 {
        font-size: 1.5rem;
    }
    
    .tcs-footer-main {
        padding: 40px 0 30px;
    }
    
    .tcs-footer-payment-icons {
        flex-wrap: wrap;
        justify-content: center;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-footer-column,
    .tcs-footer::before {
        animation: none !important;
    }
}
</style>

