<style is:global>
/* Force everything clickable */
.tcs-lead-section,
.tcs-lead-section * {
    pointer-events: auto !important;
}

.tcs-lead-section input,
.tcs-lead-section select,
.tcs-lead-section textarea,
.tcs-lead-section button {
    cursor: pointer !important;
}

/* Section Container */
.tcs-lead-section {
    background: linear-gradient(135deg, #FFF8F0, #FFFFFF);
    padding: 80px 0;
}

.tcs-lead-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.tcs-lead-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 50px;
    align-items: start;
}

/* LEFT SIDE - Benefits */
.tcs-lead-benefits {
    position: sticky;
    top: 100px;
}

.tcs-lead-main-heading {
    text-align: center;
    margin-bottom: 20px;
}

.tcs-lead-icon-badge {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    box-shadow: 0 10px 30px rgba(255, 140, 66, 0.4);
}

.tcs-lead-icon-badge svg {
    width: 40px;
    height: 40px;
    fill: white;
}

.tcs-lead-main-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 15px;
    line-height: 1.2;
}

.tcs-lead-main-subtitle {
    font-size: 1.1rem;
    color: #666;
    line-height: 1.6;
}

.tcs-benefit-cards {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 40px;
}

.tcs-benefit-card {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    gap: 20px;
    align-items: flex-start;
    transition: all 0.3s ease;
}

.tcs-benefit-card:hover {
    transform: translateX(10px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
}

.tcs-benefit-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.3);
}

.tcs-benefit-icon svg {
    width: 24px;
    height: 24px;
    fill: white;
}

.tcs-benefit-content h4 {
    font-size: 1.2rem;
    font-weight: 800;
    color: #2C1810;
    margin-bottom: 8px;
}

.tcs-benefit-content p {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.5;
    margin: 0;
}

/* RIGHT SIDE - Form */
.tcs-lead-form-wrapper {
    background: white;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
}

.tcs-form-header {
    text-align: center;
    margin-bottom: 30px;
}

.tcs-form-title {
    font-size: 2rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 10px;
}

.tcs-form-subtitle {
    font-size: 1rem;
    color: #666;
}

.tcs-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

.tcs-form-group {
    margin-bottom: 20px;
}

.tcs-form-group label {
    display: block;
    font-weight: 700;
    color: #2C1810;
    margin-bottom: 8px;
    font-size: 0.9rem;
}

.tcs-form-group label .required {
    color: #FF8C42;
}

.tcs-form-input,
.tcs-form-select,
.tcs-form-textarea {
    width: 100%;
    padding: 14px 18px;
    border: 2px solid #E5E5E5;
    border-radius: 10px;
    font-size: 1rem;
    transition: all 0.3s;
    background: white;
    font-family: inherit;
}

.tcs-form-input:focus,
.tcs-form-select:focus,
.tcs-form-textarea:focus {
    outline: none;
    border-color: #FF8C42;
    box-shadow: 0 0 0 3px rgba(255, 140, 66, 0.1);
}

.tcs-form-textarea {
    resize: vertical;
    min-height: 120px;
}

.tcs-form-submit {
    width: 100%;
    padding: 18px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    border: none;
    border-radius: 50px;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 8px 20px rgba(255, 140, 66, 0.4);
}

.tcs-form-submit:hover {
    background: linear-gradient(135deg, #D2691E, #8B4513);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(255, 140, 66, 0.5);
}

.tcs-form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

.tcs-form-message {
    padding: 15px 20px;
    border-radius: 10px;
    margin-bottom: 20px;
    font-weight: 600;
    display: none;
}

.tcs-form-message.success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
    display: block;
}

.tcs-form-message.error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
    display: block;
}

.tcs-form-privacy {
    font-size: 0.85rem;
    color: #666;
    margin-top: 15px;
    text-align: center;
}

.tcs-form-privacy a {
    color: #FF8C42;
    text-decoration: none;
}

/* Responsive */
@media (max-width: 968px) {
    .tcs-lead-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
    
    .tcs-lead-benefits {
        position: static;
    }
    
    .tcs-lead-main-title {
        font-size: 2rem;
    }
}

@media (max-width: 768px) {
    .tcs-lead-section {
        padding: 60px 0;
    }
    
    .tcs-lead-form-wrapper {
        padding: 30px 20px;
    }
    
    .tcs-form-row {
        grid-template-columns: 1fr;
    }
    
    .tcs-benefit-cards {
        margin-top: 30px;
    }
}
</style>

<section class="tcs-lead-section">
    <div class="tcs-lead-container">
        
        <div class="tcs-lead-grid">
            
            <!-- LEFT SIDE - Benefits -->
            <div class="tcs-lead-benefits">
                
                <!-- Main Heading -->
                <div class="tcs-lead-main-heading">
                    <div class="tcs-lead-icon-badge">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 11l3 3L22 4M5 11l3 3" stroke="white" stroke-width="2" fill="none" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <h2 class="tcs-lead-main-title">Request Your Free Quote</h2>
                    <p class="tcs-lead-main-subtitle">
                        Fill out the form below and our team will get back to you within 24 hours with a custom quote
                    </p>
                </div>
                
                <!-- Benefit Cards -->
                <div class="tcs-benefit-cards">
                    
                    <!-- Benefit 1: Free Design Service -->
                    <div class="tcs-benefit-card">
                        <div class="tcs-benefit-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                            </svg>
                        </div>
                        <div class="tcs-benefit-content">
                            <h4>Free Design Service</h4>
                            <p>Our expert designers will create your custom artwork at no additional cost.</p>
                        </div>
                    </div>
                    
                    <!-- Benefit 2: Fast Turnaround -->
                    <div class="tcs-benefit-card">
                        <div class="tcs-benefit-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z"/>
                            </svg>
                        </div>
                        <div class="tcs-benefit-content">
                            <h4>Fast Turnaround</h4>
                            <p>Standard production in 7-10 business days with rush options available.</p>
                        </div>
                    </div>
                    
                    <!-- Benefit 3: Premium Quality -->
                    <div class="tcs-benefit-card">
                        <div class="tcs-benefit-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                            </svg>
                        </div>
                        <div class="tcs-benefit-content">
                            <h4>Premium Quality</h4>
                            <p>Quality materials and printing, backed by a 10-day return policy.</p>
                        </div>
                    </div>
                    
                    <!-- Benefit 4: 24/7 Support -->
                    <div class="tcs-benefit-card">
                        <div class="tcs-benefit-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                <line x1="9" y1="9" x2="15" y2="9"/>
                                <line x1="9" y1="15" x2="15" y2="15"/>
                            </svg>
                        </div>
                        <div class="tcs-benefit-content">
                            <h4>Dedicated Support</h4>
                            <p>Our team is ready to assist you by phone or email throughout the process.</p>
                        </div>
                    </div>
                    
                </div>
                
            </div>
            
            <!-- RIGHT SIDE - Form -->
            <div class="tcs-lead-form-wrapper">
                
                <div class="tcs-form-header">
                    <h3 class="tcs-form-title">Get Your Free Quote</h3>
                    <p class="tcs-form-subtitle">Fill out the form and we'll get back to you within 24 hours</p>
                </div>
                
                <!-- Success/Error Message -->
                <div id="formMessage" class="tcs-form-message"></div>
                
                <!-- Form -->
                <form id="quoteForm" method="POST">
                    
                    <!-- Row 1: Name & Email -->
                    <div class="tcs-form-row">
                        <div class="tcs-form-group">
                            <label for="name">Your Name <span class="required">*</span></label>
                            <input type="text" id="name" name="name" class="tcs-form-input" placeholder="James Taylor" required>
                        </div>
                        
                        <div class="tcs-form-group">
                            <label for="email">Email Address <span class="required">*</span></label>
                            <input type="email" id="email" name="email" class="tcs-form-input" placeholder="james@company.com" required>
                        </div>
                    </div>
                    
                    <!-- Row 2: Phone & Company -->
                    <div class="tcs-form-row">
                        <div class="tcs-form-group">
                            <label for="phone">Phone Number <span class="required">*</span></label>
                            <input type="tel" id="phone" name="phone" class="tcs-form-input" placeholder="(503) 358-0443" required>
                        </div>
                        
                        <div class="tcs-form-group">
                            <label for="company">Company Name</label>
                            <input type="text" id="company" name="company" class="tcs-form-input" placeholder="Your Company">
                        </div>
                    </div>
                    
                    <!-- Row 3: Quantity & Material -->
                    <div class="tcs-form-row">
                        <div class="tcs-form-group">
                            <label for="quantity">Estimated Quantity <span class="required">*</span></label>
                            <select id="quantity" name="quantity" class="tcs-form-select" required>
                                <option value="">Select quantity</option>
                                <option value="100-500">100 - 500 units</option>
                                <option value="500-1000">500 - 1,000 units</option>
                                <option value="1000-5000">1,000 - 5,000 units</option>
                                <option value="5000-10000">5,000 - 10,000 units</option>
                                <option value="10000+">10,000+ units</option>
                            </select>
                        </div>
                        
                        <div class="tcs-form-group">
                            <label for="material">Preferred Material</label>
                            <select id="material" name="material" class="tcs-form-select">
                                <option value="">Select material</option>
                                <option value="Kraft Paper">Kraft Paper</option>
                                <option value="Cardboard">Cardboard</option>
                                <option value="Corrugated">Corrugated</option>
                                <option value="Custom">Custom Material</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Project Details -->
                    <div class="tcs-form-group">
                        <label for="details">Project Details</label>
                        <textarea id="details" name="details" class="tcs-form-textarea" placeholder="Tell us about your project, design requirements, deadlines, etc."></textarea>
                    </div>
                    
                    <!-- Submit Button -->
                    <button type="submit" class="tcs-form-submit" id="submitBtn">
                        Get My Free Quote
                    </button>
                    
                    <!-- Privacy Notice -->
                    <div class="tcs-form-privacy">
                        Your information is secure and will never be shared. Read our <a href="/privacy-policy/">Privacy Policy</a>.
                    </div>
                    
                </form>
                
            </div>
            
        </div>
        
    </div>
</section>

<script is:inline>
(function() {
    'use strict';
    
    const form = document.getElementById('quoteForm');
    const submitBtn = document.getElementById('submitBtn');
    const messageDiv = document.getElementById('formMessage');
    
    if (!form) return;
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Disable submit button
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        
        // Hide previous messages
        messageDiv.style.display = 'none';
        messageDiv.className = 'tcs-form-message';
        
        // Get form data
        const formData = new FormData(form);
        
        // Send AJAX request
        fetch('/api/quote/', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.assign('/thank-you/');
            } else {
                // Error from server
                throw new Error(data.message || 'Failed to send request');
            }
        })
        .catch(error => {
            // Error
            messageDiv.className = 'tcs-form-message error';
            messageDiv.textContent = error.message || 'Oops! Something went wrong. Please try again or call us at (503) 358-0443.';
            messageDiv.style.display = 'block';
            
            console.error('Form error:', error);
        })
        .finally(() => {
            // Re-enable submit button
            submitBtn.disabled = false;
            submitBtn.textContent = 'Get My Free Quote';
        });
    });
    
    console.log('Lead form section initialized');
    
})();
</script>
