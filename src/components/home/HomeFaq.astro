                <div class="tcs-faq-item-inner">
                    <div class="tcs-faq-question">
                        <div class="tcs-faq-number">08</div>
                        <div class="tcs-faq-question-text">What printing options are available?</div>
                        <div class="tcs-faq-toggle">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <line x1="5" y1="12" x2="19" y2="12"/>
