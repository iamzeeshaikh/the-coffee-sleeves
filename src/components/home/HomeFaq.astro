<style is:global>
/* FAQ Section */
.tcs-faq {
    position: relative;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFF8F0 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Background Decoration */
.tcs-faq::before {
    content: '?';
    position: absolute;
    font-size: 300px;
    color: rgba(255, 140, 66, 0.03);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-weight: 900;
    animation: rotate 40s linear infinite;
}

@keyframes rotate {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
}

.tcs-faq-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Section Header */
.tcs-faq-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tcs-faq-badge {
    display: inline-block;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
}

.tcs-faq-title {
    font-size: 3rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
}

.tcs-faq-subtitle {
    font-size: 1.2rem;
    color: #666666;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* FAQ Items Container */
.tcs-faq-items {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* Individual FAQ Item */
.tcs-faq-item {
    perspective: 1200px;
    animation: fadeInScale 0.6s ease-out forwards;
    opacity: 0;
}

.tcs-faq-item:nth-child(1) { animation-delay: 0.1s; }
.tcs-faq-item:nth-child(2) { animation-delay: 0.15s; }
.tcs-faq-item:nth-child(3) { animation-delay: 0.2s; }
.tcs-faq-item:nth-child(4) { animation-delay: 0.25s; }
.tcs-faq-item:nth-child(5) { animation-delay: 0.3s; }
.tcs-faq-item:nth-child(6) { animation-delay: 0.35s; }
.tcs-faq-item:nth-child(7) { animation-delay: 0.4s; }
.tcs-faq-item:nth-child(8) { animation-delay: 0.45s; }
.tcs-faq-item:nth-child(9) { animation-delay: 0.5s; }
.tcs-faq-item:nth-child(10) { animation-delay: 0.55s; }
.tcs-faq-item:nth-child(11) { animation-delay: 0.6s; }
.tcs-faq-item:nth-child(12) { animation-delay: 0.65s; }

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: translateY(20px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* FAQ Item Inner */
.tcs-faq-item-inner {
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    overflow: hidden;
    border: 2px solid transparent;
}

.tcs-faq-item:hover .tcs-faq-item-inner {
    box-shadow: 
        0 15px 40px rgba(0, 0, 0, 0.12),
        0 0 30px rgba(255, 140, 66, 0.15);
    transform: translateY(-5px);
    border-color: rgba(255, 140, 66, 0.3);
}

.tcs-faq-item.active .tcs-faq-item-inner {
    box-shadow: 
        0 15px 40px rgba(0, 0, 0, 0.15),
        0 0 40px rgba(255, 140, 66, 0.25);
    border-color: rgba(255, 140, 66, 0.5);
}

/* FAQ Question Header */
.tcs-faq-question {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 25px 30px;
    cursor: pointer;
    position: relative;
    user-select: none;
    transition: all 0.3s ease;
}

.tcs-faq-item:hover .tcs-faq-question {
    background: rgba(255, 140, 66, 0.03);
}

.tcs-faq-item.active .tcs-faq-question {
    background: rgba(255, 140, 66, 0.05);
}

/* Question Number */
.tcs-faq-number {
    width: 45px;
    height: 45px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 900;
    color: white;
    flex-shrink: 0;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.3);
    transition: all 0.3s ease;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-faq-item:hover .tcs-faq-number {
    transform: scale(1.1) rotateY(10deg);
}

.tcs-faq-item.active .tcs-faq-number {
    transform: scale(1.15) rotateY(180deg);
}

/* Question Text */
.tcs-faq-question-text {
    flex: 1;
    font-size: 1.15rem;
    font-weight: 700;
    color: #2C1810;
    line-height: 1.5;
    transition: color 0.3s ease;
}

.tcs-faq-item.active .tcs-faq-question-text {
    color: #FF8C42;
}

/* Toggle Icon */
.tcs-faq-toggle {
    width: 35px;
    height: 35px;
    background: rgba(255, 140, 66, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.tcs-faq-item:hover .tcs-faq-toggle {
    background: rgba(255, 140, 66, 0.2);
    transform: scale(1.1);
}

.tcs-faq-item.active .tcs-faq-toggle {
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    transform: scale(1.1) rotate(180deg);
}

.tcs-faq-toggle svg {
    width: 20px;
    height: 20px;
    stroke: #FF8C42;
    transition: all 0.3s ease;
}

.tcs-faq-item.active .tcs-faq-toggle svg {
    stroke: white;
}

/* FAQ Answer */
.tcs-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.tcs-faq-item.active .tcs-faq-answer {
    max-height: 1000px;
}

.tcs-faq-answer-content {
    padding: 0 30px 25px 95px;
    color: #666666;
    font-size: 1rem;
    line-height: 1.8;
    transform: translateY(-10px);
    opacity: 0;
    transition: all 0.3s ease 0.1s;
}

.tcs-faq-item.active .tcs-faq-answer-content {
    transform: translateY(0);
    opacity: 1;
}

/* Highlight Box for Important Info */
.tcs-faq-highlight {
    background: rgba(255, 140, 66, 0.08);
    border-left: 4px solid #FF8C42;
    padding: 15px 20px;
    margin-top: 15px;
    border-radius: 8px;
}

.tcs-faq-highlight-title {
    font-weight: 700;
    color: #FF8C42;
    margin-bottom: 8px;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.tcs-faq-highlight-text {
    color: #2C1810;
    font-size: 0.95rem;
    line-height: 1.6;
}

/* Divider Line */
.tcs-faq-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 140, 66, 0.2), transparent);
    margin: 0 30px;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.tcs-faq-item.active .tcs-faq-divider {
    opacity: 1;
}

/* Still Have Questions CTA */
.tcs-faq-cta {
    text-align: center;
    margin-top: 60px;
    padding: 40px;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.1), rgba(210, 105, 30, 0.1));
    border-radius: 20px;
    border: 2px dashed rgba(255, 140, 66, 0.3);
    animation: fadeInUp 1s ease-out 0.8s backwards;
}

.tcs-faq-cta-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 8px 20px rgba(255, 140, 66, 0.4);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.tcs-faq-cta-icon svg {
    width: 30px;
    height: 30px;
    fill: white;
}

.tcs-faq-cta-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #2C1810;
    margin-bottom: 12px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-faq-cta-text {
    font-size: 1.1rem;
    color: #666666;
    margin-bottom: 25px;
}

.tcs-faq-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 40px;
    background: linear-gradient(135deg, #6F4E37, #8B4513);
    color: white;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 8px 25px rgba(111, 78, 55, 0.4);
    transition: all 0.3s ease;
}

.tcs-faq-cta-btn:hover {
    background: linear-gradient(135deg, #8B4513, #3E2723);
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(111, 78, 55, 0.5);
    color: white;
}

.tcs-faq-cta-btn svg {
    width: 20px;
    height: 20px;
}

/* Responsive Design */
@media (max-width: 768px) {
    .tcs-faq {
        padding: 60px 0;
    }
    
    .tcs-faq-header {
        margin-bottom: 50px;
    }
    
    .tcs-faq-title {
        font-size: 2rem;
    }
    
    .tcs-faq-subtitle {
        font-size: 1rem;
    }
    
    .tcs-faq-question {
        padding: 20px;
        gap: 15px;
    }
    
    .tcs-faq-number {
        width: 40px;
        height: 40px;
        font-size: 1rem;
    }
    
    .tcs-faq-question-text {
        font-size: 1rem;
    }
    
    .tcs-faq-answer-content {
        padding: 0 20px 20px 75px;
        font-size: 0.95rem;
    }
    
    .tcs-faq-cta {
        padding: 30px 20px;
    }
    
    .tcs-faq-cta-title {
        font-size: 1.5rem;
    }
}

@media (max-width: 480px) {
    .tcs-faq-title {
        font-size: 1.75rem;
    }
    
    .tcs-faq-answer-content {
        padding: 0 20px 20px 20px;
    }
    
    .tcs-faq-question {
        flex-direction: row;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-faq-item,
    .tcs-faq-header,
    .tcs-faq-number,
    .tcs-faq::before,
    .tcs-faq-cta-icon {
        animation: none !important;
    }
}
</style>

<!-- FAQ Section HTML -->
<section class="tcs-faq" id="tcsFAQ">
    <div class="tcs-faq-container">
        
        <!-- Section Header -->
        <div class="tcs-faq-header">
            <div class="tcs-faq-badge">❓ FAQ</div>
            <h2 class="tcs-faq-title">Frequently Asked Questions</h2>
