<script is:inline>
(function() {
    'use strict';
    
    // 3D Tilt Effect for Benefit Cards
    function init3DTilt() {
        const benefitCards = document.querySelectorAll('.tcs-why-card-inner');
        
        benefitCards.forEach(card => {
            card.addEventListener('mousemove', function(e) {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = (y - centerY) / 15;
                const rotateY = (centerX - x) / 15;
                
                card.style.transform = `translateY(-12px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            });
            
            card.addEventListener('mouseleave', function() {
                card.style.transform = '';
            });
        });
    }
    
    // Icon Animation on Scroll
    function initIconAnimation() {
        const icons = document.querySelectorAll('.tcs-why-icon');
        
        const observerOptions = {
            threshold: 0.3,
            rootMargin: '0px 0px -100px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = 'iconBounce 0.6s ease';
                    setTimeout(() => {
                        entry.target.style.animation = '';
                    }, 600);
                }
            });
        }, observerOptions);
        
        icons.forEach(icon => {
            observer.observe(icon);
        });
    }
    
    // Card Hover Sound Effect (Optional)
    function initHoverEffects() {
        const cards = document.querySelectorAll('.tcs-why-card');
        
        cards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                const number = this.querySelector('.tcs-why-number');
                if (number) {
                    number.style.animation = 'pulse 0.3s ease';
                    setTimeout(() => {
                        number.style.animation = '';
                    }, 300);
                }
            });
        });
    }
    
    // Stagger Animation on Scroll
    function initScrollAnimations() {
        const cards = document.querySelectorAll('.tcs-why-card');
        
        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animationPlayState = 'running';
                }
            });
        }, observerOptions);
        
        cards.forEach(card => {
            observer.observe(card);
        });
    }
    
    // Initialize all functions
    function init() {
        if (window.innerWidth > 768) {
            init3DTilt();
        }
        
        initIconAnimation();
        initHoverEffects();
        initScrollAnimations();
        
        console.log('The Coffee Sleeves Why Choose Us - Initialized');
    }
    
    // Run when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
})();
</script>
