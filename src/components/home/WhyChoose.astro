<style is:global>
/* Why Choose Us Section */
.tcs-why-choose {
    position: relative;
    background: linear-gradient(135deg, #2C1810 0%, #3E2723 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Animated Background */
.tcs-why-choose::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 15% 20%, rgba(255, 140, 66, 0.1) 0%, transparent 40%),
        radial-gradient(circle at 85% 80%, rgba(210, 105, 30, 0.1) 0%, transparent 40%);
    animation: bgPulse 20s ease-in-out infinite;
}

@keyframes bgPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
}

/* Floating Elements */
.tcs-why-choose::after {
    content: '✓';
    position: absolute;
    font-size: 150px;
    color: rgba(255, 140, 66, 0.05);
    top: 20%;
    right: 10%;
    animation: float 15s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-30px) rotate(10deg); }
}

.tcs-why-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Section Header */
.tcs-why-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tcs-why-badge {
    display: inline-block;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
}

.tcs-why-title {
    font-size: 3rem;
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.tcs-why-subtitle {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Benefits Grid */
.tcs-why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 35px;
}

/* 3D Benefit Card */
.tcs-why-card {
    perspective: 1000px;
    animation: fadeInScale 0.8s ease-out forwards;
    opacity: 0;
}

.tcs-why-card:nth-child(1) { animation-delay: 0.1s; }
.tcs-why-card:nth-child(2) { animation-delay: 0.2s; }
.tcs-why-card:nth-child(3) { animation-delay: 0.3s; }
.tcs-why-card:nth-child(4) { animation-delay: 0.4s; }
.tcs-why-card:nth-child(5) { animation-delay: 0.5s; }
.tcs-why-card:nth-child(6) { animation-delay: 0.6s; }

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.8) translateY(30px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.tcs-why-card-inner {
    position: relative;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(15px);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 35px 30px;
    height: 100%;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    overflow: hidden;
}

.tcs-why-card:hover .tcs-why-card-inner {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 140, 66, 0.4);
    transform: translateY(-12px) rotateX(5deg);
    box-shadow: 
        0 20px 40px rgba(0, 0, 0, 0.4),
        0 0 40px rgba(255, 140, 66, 0.3);
}

/* Gradient Background on Hover */
.tcs-why-card-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.1), rgba(210, 105, 30, 0.1));
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 20px;
    z-index: 0;
}

.tcs-why-card:hover .tcs-why-card-inner::before {
    opacity: 1;
}

/* Content Wrapper */
.tcs-why-content {
    position: relative;
    z-index: 1;
}

/* 3D Icon Container */
.tcs-why-icon-container {
    position: relative;
    width: 80px;
    height: 80px;
    margin-bottom: 25px;
    perspective: 1000px;
}

.tcs-why-icon {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 35px;
    box-shadow: 
        0 10px 30px rgba(255, 140, 66, 0.4),
        inset 0 -5px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    position: relative;
}

/* Icon Glow Effect */
.tcs-why-icon::before {
    content: '';
    position: absolute;
    top: -6px;
    left: -6px;
    right: -6px;
    bottom: -6px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 18px;
    opacity: 0.5;
    filter: blur(20px);
    z-index: -1;
    transition: all 0.3s ease;
}

.tcs-why-card:hover .tcs-why-icon {
    transform: translateZ(30px) rotateY(10deg) scale(1.1);
    animation: iconBounce 0.6s ease;
}

.tcs-why-card:hover .tcs-why-icon::before {
    opacity: 0.8;
    filter: blur(25px);
}

@keyframes iconBounce {
    0%, 100% { transform: translateZ(30px) rotateY(10deg) scale(1.1); }
    50% { transform: translateZ(40px) rotateY(15deg) scale(1.15); }
}

/* Title */
.tcs-why-benefit-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 12px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    transition: color 0.3s ease;
}

.tcs-why-card:hover .tcs-why-benefit-title {
    color: #FFE8D6;
}

/* Description */
.tcs-why-benefit-description {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    transition: color 0.3s ease;
}

.tcs-why-card:hover .tcs-why-benefit-description {
    color: rgba(255, 255, 255, 0.9);
}

/* Number Badge */
.tcs-why-number {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 35px;
    height: 35px;
    background: rgba(255, 140, 66, 0.2);
    border: 2px solid rgba(255, 140, 66, 0.4);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 800;
    color: #FF8C42;
    transition: all 0.3s ease;
}

.tcs-why-card:hover .tcs-why-number {
    background: rgba(255, 140, 66, 0.3);
    border-color: #FF8C42;
    transform: scale(1.1) rotate(10deg);
}

/* Decorative Element */
.tcs-why-decoration {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 100px;
    height: 100px;
    background: radial-gradient(circle, rgba(255, 140, 66, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    transition: all 0.3s ease;
}

.tcs-why-card:hover .tcs-why-decoration {
    transform: scale(1.5);
    opacity: 0.5;
}

/* Shine Effect */
.tcs-why-card-inner::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
        45deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
    );
    transform: rotate(45deg);
    transition: all 0.5s ease;
    opacity: 0;
}

.tcs-why-card:hover .tcs-why-card-inner::after {
    opacity: 1;
    animation: shine 0.8s ease;
}

@keyframes shine {
    from { left: -50%; }
    to { left: 150%; }
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-why-title {
        font-size: 2.5rem;
    }
    
    .tcs-why-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }
}

@media (max-width: 768px) {
    .tcs-why-choose {
        padding: 60px 0;
    }
    
    .tcs-why-header {
        margin-bottom: 50px;
    }
    
    .tcs-why-title {
        font-size: 2rem;
    }
    
    .tcs-why-subtitle {
        font-size: 1rem;
    }
    
    .tcs-why-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }
    
    .tcs-why-icon-container {
        width: 65px;
        height: 65px;
    }
    
    .tcs-why-icon {
        font-size: 30px;
    }
    
    .tcs-why-benefit-title {
        font-size: 1.3rem;
    }
}

@media (max-width: 480px) {
    .tcs-why-title {
        font-size: 1.75rem;
    }
    
    .tcs-why-card-inner {
        padding: 28px 25px;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-why-card,
    .tcs-why-header,
    .tcs-why-icon,
    .tcs-why-choose::before,
    .tcs-why-choose::after {
        animation: none !important;
    }
}
</style>

