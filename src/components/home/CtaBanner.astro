<script is:inline>
(function() {
    'use strict';
    
    // 3D Tilt Effect for CTA Card
    function init3DTilt() {
        const ctaCard = document.querySelector('.tcs-cta-card-inner');
        
        if (ctaCard && window.innerWidth > 768) {
            ctaCard.addEventListener('mousemove', function(e) {
                const rect = ctaCard.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = (y - centerY) / 30;
                const rotateY = (centerX - x) / 30;
                
                ctaCard.style.transform = `translateY(-10px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            });
            
            ctaCard.addEventListener('mouseleave', function() {
                ctaCard.style.transform = '';
            });
        }
    }
    
    // Button Click Animation
    function initButtonAnimations() {
        const buttons = document.querySelectorAll('.tcs-cta-btn');
        
        buttons.forEach(button => {
            button.addEventListener('click', function(e) {
                // Create ripple effect
                const ripple = document.createElement('span');
                const rect = button.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);
                const x = e.clientX - rect.left - size / 2;
                const y = e.clientY - rect.top - size / 2;
                
                ripple.style.cssText = `
                    position: absolute;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.5);
                    width: ${size}px;
                    height: ${size}px;
                    left: ${x}px;
                    top: ${y}px;
                    animation: ripple 0.6s ease-out;
                    pointer-events: none;
                `;
                
                button.style.position = 'relative';
                button.style.overflow = 'hidden';
                button.appendChild(ripple);
                
                setTimeout(() => ripple.remove(), 600);
            });
        });
    }
    
    // Trust Elements Animation on Scroll
    function initTrustAnimation() {
        const trustItems = document.querySelectorAll('.tcs-cta-trust-item');
        
        const observerOptions = {
            threshold: 0.5,
            rootMargin: '0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach((entry, index) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.style.animation = 'fadeInUp 0.6s ease-out forwards';
                        entry.target.style.opacity = '0';
                        setTimeout(() => {
                            entry.target.style.opacity = '1';
                        }, 50);
                    }, index * 100);
                }
            });
        }, observerOptions);
        
        trustItems.forEach(item => {
            observer.observe(item);
        });
    }
    
    // Add ripple animation keyframes
    const style = document.createElement('style');
    style.textContent = `
        @keyframes ripple {
            from {
                opacity: 1;
                transform: scale(0);
            }
            to {
                opacity: 0;
                transform: scale(4);
            }
        }
    `;
    document.head.appendChild(style);
    
    // Initialize
    function init() {
        init3DTilt();
        initButtonAnimations();
        initTrustAnimation();
        
        console.log('The Coffee Sleeves CTA Banner - Initialized');
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
})();
</script>
