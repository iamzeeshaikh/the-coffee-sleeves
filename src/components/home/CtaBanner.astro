<style is:global>
/* CTA Banner Section */
.tcs-cta-banner {
    position: relative;
    background: linear-gradient(135deg, #6F4E37 0%, #8B4513 50%, #3E2723 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Animated Background Pattern */
.tcs-cta-banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 15% 25%, rgba(255, 140, 66, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 85% 75%, rgba(210, 105, 30, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 50% 50%, rgba(255, 140, 66, 0.08) 0%, transparent 60%);
    animation: bgPulse 15s ease-in-out infinite;
}

@keyframes bgPulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
}

/* Floating Coffee Beans */
.tcs-cta-banner::after {
    content: '☕';
    position: absolute;
    font-size: 120px;
    color: rgba(255, 140, 66, 0.08);
    top: 20%;
    right: 10%;
    animation: float 8s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(15deg); }
}

.tcs-cta-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Main CTA Card */
.tcs-cta-card {
    perspective: 1500px;
    animation: fadeInScale 0.8s ease-out;
}

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.9) translateY(30px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.tcs-cta-card-inner {
    position: relative;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 30px;
    padding: 60px 50px;
    text-align: center;
    box-shadow: 
        0 20px 60px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  
    overflow: hidden;
}

.tcs-cta-card:hover .tcs-cta-card-inner {
    transform: translateY(-10px);
    box-shadow: 
        0 30px 80px rgba(0, 0, 0, 0.5),
        0 0 60px rgba(255, 140, 66, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 140, 66, 0.4);
}

/* Gradient Overlay */
.tcs-cta-card-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.1), rgba(210, 105, 30, 0.1));
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 30px;
}

.tcs-cta-card:hover .tcs-cta-card-inner::before {
    opacity: 1;
}

/* Badge */
.tcs-cta-badge {
    display: inline-block;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    padding: 10px 25px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 8px 20px rgba(255, 140, 66, 0.5);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

/* Main Headline */
.tcs-cta-headline {
    font-size: 3.5rem;
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: 20px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
    text-shadow: 
        0 4px 20px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(255, 140, 66, 0.3);
    animation: textGlow 3s ease-in-out infinite;
}

@keyframes textGlow {
    0%, 100% { text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 30px rgba(255, 140, 66, 0.3); }
    50% { text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 40px rgba(255, 140, 66, 0.5); }
}

/* Subheadline */
.tcs-cta-subheadline {
    font-size: 1.4rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 35px;
    line-height: 1.6;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
}

/* Trust Elements */
.tcs-cta-trust {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-bottom: 40px;
    flex-wrap: wrap;
}

.tcs-cta-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.3s ease;
}

.tcs-cta-trust-item:hover {
    transform: translateY(-3px);
    color: #FFE8D6;
}

.tcs-cta-trust-icon {
    width: 45px;
    height: 45px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
    transition: all 0.3s ease;
}

.tcs-cta-trust-item:hover .tcs-cta-trust-icon {
    transform: scale(1.1) rotateY(15deg);
    box-shadow: 0 8px 20px rgba(255, 140, 66, 0.6);
}

.tcs-cta-trust-icon svg {
    width: 24px;
    height: 24px;
    fill: white;
}

/* CTA Buttons */
.tcs-cta-buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

.tcs-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 20px 45px;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
}

/* Primary Button */
.tcs-cta-btn-primary {
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    box-shadow: 0 10px 30px rgba(255, 140, 66, 0.5);
}

.tcs-cta-btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s ease;
}

.tcs-cta-btn-primary:hover {
    background: linear-gradient(135deg, #D2691E, #8B4513);
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 40px rgba(255, 140, 66, 0.7);
    color: white;
}

.tcs-cta-btn-primary:hover::before {
    left: 100%;
}

/* Secondary Button */
.tcs-cta-btn-secondary {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px);
}

.tcs-cta-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 140, 66, 0.6);
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 40px rgba(255, 255, 255, 0.3);
    color: white;
}

.tcs-cta-btn svg {
    width: 22px;
    height: 22px;
    transition: transform 0.3s ease;
}

.tcs-cta-btn:hover svg {
    transform: translateX(5px);
}

/* Guarantee Badge */
.tcs-cta-guarantee {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 12px 25px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50px;
    backdrop-filter: blur(10px);
}

.tcs-cta-guarantee svg {
    width: 20px;
    height: 20px;
    fill: #FF8C42;
}

/* Decorative Elements */
.tcs-cta-decoration {
    position: absolute;
    pointer-events: none;
}

.tcs-cta-decoration-1 {
    top: -30px;
    right: -30px;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(255, 140, 66, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    animation: rotate 20s linear infinite;
}

.tcs-cta-decoration-2 {
    bottom: -40px;
    left: -40px;
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(210, 105, 30, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    animation: rotate 25s linear infinite reverse;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* Shine Effect */
.tcs-cta-card-inner::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
        45deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
    );
    transform: rotate(45deg);
    animation: shine 4s ease-in-out infinite;
}

@keyframes shine {
    0%, 100% { left: -50%; opacity: 0; }
    50% { left: 150%; opacity: 1; }
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-cta-headline {
        font-size: 3rem;
    }
    
    .tcs-cta-trust {
        gap: 30px;
    }
}

@media (max-width: 768px) {
    .tcs-cta-banner {
        padding: 60px 0;
    }
    
    .tcs-cta-card-inner {
        padding: 50px 30px;
    }
    
    .tcs-cta-headline {
        font-size: 2.2rem;
    }
    
    .tcs-cta-subheadline {
        font-size: 1.2rem;
    }
    
    .tcs-cta-trust {
        flex-direction: column;
        gap: 20px;
        align-items: center;
    }
    
    .tcs-cta-buttons {
        flex-direction: column;
        width: 100%;
    }
    
    .tcs-cta-btn {
        width: 100%;
        justify-content: center;
        padding: 18px 35px;
        font-size: 1rem;
    }
}

@media (max-width: 480px) {
    .tcs-cta-card-inner {
        padding: 40px 25px;
        border-radius: 20px;
    }
    
    .tcs-cta-headline {
        font-size: 1.9rem;
    }
    
    .tcs-cta-subheadline {
        font-size: 1.1rem;
    }
    
    .tcs-cta-badge {
        font-size: 0.8rem;
        padding: 8px 20px;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-cta-card,
    .tcs-cta-badge,
    .tcs-cta-headline,
    .tcs-cta-banner::before,
    .tcs-cta-banner::after,
    .tcs-cta-decoration-1,
    .tcs-cta-decoration-2,
    .tcs-cta-card-inner::after {
        animation: none !important;
    }
}
</style>

