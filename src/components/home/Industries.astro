<style is:global>
/* Industries Section */
.tcs-industries {
    position: relative;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFF8F0 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Background Decoration */
.tcs-industries::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 20% 80%, rgba(255, 140, 66, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(210, 105, 30, 0.05) 0%, transparent 50%);
    animation: bgMove 15s ease-in-out infinite;
}

@keyframes bgMove {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.tcs-industries-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Section Header */
.tcs-industries-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tcs-industries-badge {
    display: inline-block;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
}

.tcs-industries-title {
    font-size: 3rem;
    font-weight: 900;
    color: #2C1810;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
}

.tcs-industries-subtitle {
    font-size: 1.2rem;
    color: #666666;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Industries Grid */
.tcs-industries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 35px;
}

/* 3D Industry Card */
.tcs-industry-card {
    perspective: 1200px;
    animation: fadeInScale 0.8s ease-out forwards;
    opacity: 0;
}

.tcs-industry-card:nth-child(1) { animation-delay: 0.1s; }
.tcs-industry-card:nth-child(2) { animation-delay: 0.2s; }
.tcs-industry-card:nth-child(3) { animation-delay: 0.3s; }
.tcs-industry-card:nth-child(4) { animation-delay: 0.4s; }
.tcs-industry-card:nth-child(5) { animation-delay: 0.5s; }
.tcs-industry-card:nth-child(6) { animation-delay: 0.6s; }

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.8) translateY(30px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.tcs-industry-card-inner {
    position: relative;
    background: white;
    border-radius: 20px;
    padding: 40px 30px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    height: 100%;
    cursor: pointer;
    overflow: hidden;
}

.tcs-industry-card:hover .tcs-industry-card-inner {
    transform: translateY(-15px) rotateX(5deg) scale(1.05);
    box-shadow: 
        0 25px 50px rgba(0, 0, 0, 0.15),
        0 0 40px rgba(255, 140, 66, 0.2);
}

/* Background Gradient on Hover */
.tcs-industry-card-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.05), rgba(210, 105, 30, 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 20px;
    z-index: 0;
}

.tcs-industry-card:hover .tcs-industry-card-inner::before {
    opacity: 1;
}

/* Content Wrapper */
.tcs-industry-content {
    position: relative;
    z-index: 1;
}

/* 3D Icon Container */
.tcs-industry-icon-container {
    position: relative;
    width: 100px;
    height: 100px;
    margin: 0 auto 25px;
    perspective: 1000px;
}

.tcs-industry-icon {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
        0 10px 30px rgba(255, 140, 66, 0.4),
        inset 0 -5px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    position: relative;
}

/* Icon Glow Effect */
.tcs-industry-icon::before {
    content: '';
    position: absolute;
    top: -8px;
    left: -8px;
    right: -8px;
    bottom: -8px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 20px;
    opacity: 0.5;
    filter: blur(20px);
    z-index: -1;
    transition: all 0.3s ease;
}

.tcs-industry-card:hover .tcs-industry-icon {
    transform: translateZ(30px) rotateY(15deg) scale(1.1);
    animation: iconBounce 0.6s ease;
}

.tcs-industry-card:hover .tcs-industry-icon::before {
    opacity: 0.8;
    filter: blur(25px);
}

@keyframes iconBounce {
    0%, 100% { transform: translateZ(30px) rotateY(15deg) scale(1.1); }
    50% { transform: translateZ(40px) rotateY(20deg) scale(1.15); }
}

/* SVG Icon Styling */
.tcs-industry-icon svg {
    width: 50px;
    height: 50px;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
}

/* Industry Name */
.tcs-industry-name {
    font-size: 1.5rem;
    font-weight: 800;
    color: #2C1810;
    margin-bottom: 12px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    transition: color 0.3s ease;
}

.tcs-industry-card:hover .tcs-industry-name {
    color: #FF8C42;
}

/* Industry Description */
.tcs-industry-description {
    font-size: 0.95rem;
    color: #666666;
    line-height: 1.6;
    margin-bottom: 20px;
    transition: color 0.3s ease;
}

.tcs-industry-card:hover .tcs-industry-description {
    color: #2C1810;
}

/* Industry Stats */
.tcs-industry-stats {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding-top: 15px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
}

.tcs-industry-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.tcs-industry-stat-number {
    font-size: 1.3rem;
    font-weight: 900;
    color: #FF8C42;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-industry-stat-label {
    font-size: 0.75rem;
    color: #999999;
    text-transform: uppercase;
}

/* Decorative Circle */
.tcs-industry-decoration {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 80px;
    height: 80px;
    background: radial-gradient(circle, rgba(255, 140, 66, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    transition: all 0.3s ease;
}

.tcs-industry-card:hover .tcs-industry-decoration {
    transform: scale(1.5);
    opacity: 0.6;
}

/* Shine Effect */
.tcs-industry-card-inner::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
        45deg,
        transparent,
        rgba(255, 255, 255, 0.3),
        transparent
    );
    transform: rotate(45deg);
    transition: all 0.5s ease;
    opacity: 0;
}

.tcs-industry-card:hover .tcs-industry-card-inner::after {
    opacity: 1;
    animation: shine 0.8s ease;
}

@keyframes shine {
    from { left: -50%; }
    to { left: 150%; }
}

/* CTA Section */
.tcs-industries-cta {
    text-align: center;
    margin-top: 60px;
    padding: 40px;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.1), rgba(210, 105, 30, 0.1));
    border-radius: 20px;
    border: 2px dashed rgba(255, 140, 66, 0.3);
    animation: fadeInUp 1s ease-out 0.8s backwards;
}

.tcs-industries-cta-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #2C1810;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-industries-cta-text {
    font-size: 1.1rem;
    color: #666666;
    margin-bottom: 25px;
}

.tcs-industries-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 40px;
    background: linear-gradient(135deg, #6F4E37, #8B4513);
    color: white;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 8px 25px rgba(111, 78, 55, 0.4);
    transition: all 0.3s ease;
}

.tcs-industries-cta-btn:hover {
    background: linear-gradient(135deg, #8B4513, #3E2723);
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(111, 78, 55, 0.5);
    color: white;
}

.tcs-industries-cta-btn svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
}

.tcs-industries-cta-btn:hover svg {
    transform: translateX(5px);
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-industries-title {
        font-size: 2.5rem;
    }
    
    .tcs-industries-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }
}

@media (max-width: 768px) {
    .tcs-industries {
        padding: 60px 0;
    }
    
    .tcs-industries-header {
        margin-bottom: 50px;
    }
    
    .tcs-industries-title {
        font-size: 2rem;
    }
    
    .tcs-industries-subtitle {
        font-size: 1rem;
    }
    
    .tcs-industries-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }
    
    .tcs-industry-icon-container {
        width: 80px;
        height: 80px;
    }
    
    .tcs-industry-icon svg {
        width: 40px;
        height: 40px;
    }
    
    .tcs-industries-cta {
        margin-top: 50px;
        padding: 30px 20px;
    }
    
    .tcs-industries-cta-title {
        font-size: 1.5rem;
    }
}

@media (max-width: 480px) {
    .tcs-industries-title {
        font-size: 1.75rem;
    }
    
    .tcs-industry-card-inner {
        padding: 30px 25px;
    }
    
    .tcs-industry-name {
        font-size: 1.3rem;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-industry-card,
    .tcs-industries-header,
    .tcs-industry-icon,
    .tcs-industries::before {
        animation: none !important;
    }
}
</style>

