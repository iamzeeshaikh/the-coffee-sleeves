            <h3 class="tcs-industries-cta-title">Your Industry Not Listed?</h3>
            <p class="tcs-industries-cta-text">
                We work with businesses of all types and sizes. Let's discuss your custom coffee sleeve needs!
            </p>
            <a href="/contact/" class="tcs-industries-cta-btn">
                <span>Contact Us Today</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
            </a>
        </div>
        
    </div>
</section>

<script is:inline>
(function() {
    'use strict';
    
    // 3D Tilt Effect for Industry Cards
    function init3DTilt() {
        const industryCards = document.querySelectorAll('.tcs-industry-card-inner');
        
        industryCards.forEach(card => {
            card.addEventListener('mousemove', function(e) {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = (y - centerY) / 15;
                const rotateY = (centerX - x) / 15;
                
                card.style.transform = `translateY(-15px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.05)`;
            });
            
            card.addEventListener('mouseleave', function() {
                card.style.transform = '';
            });
        });
    }
    
    // Icon Animation on Scroll
    function initIconAnimation() {
        const cards = document.querySelectorAll('.tcs-industry-card');
        
        const observerOptions = {
            threshold: 0.3,
            rootMargin: '0px 0px -100px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const icon = entry.target.querySelector('.tcs-industry-icon');
                    if (icon) {
                        icon.style.animation = 'iconBounce 0.6s ease';
                        setTimeout(() => {
                            icon.style.animation = '';
                        }, 600);
                    }
                }
            });
        }, observerOptions);
        
        cards.forEach(card => {
            observer.observe(card);
        });
    }
    
    // Scroll Animations
    function initScrollAnimations() {
        const cards = document.querySelectorAll('.tcs-industry-card');
        
        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animationPlayState = 'running';
                }
            });
        }, observerOptions);
        
        cards.forEach(card => {
            observer.observe(card);
        });
    }
    
    // Initialize
    function init() {
        if (window.innerWidth > 768) {
            init3DTilt();
        }
        
        initIconAnimation();
        initScrollAnimations();
        
        console.log('The Coffee Sleeves Industries - Initialized');
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    
})();
</script>
