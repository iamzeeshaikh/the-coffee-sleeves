<style is:global>
/* Customization Options Section */
.tcs-customization {
    position: relative;
    background: linear-gradient(135deg, #2C1810 0%, #3E2723 100%);
    padding: 80px 0;
    overflow: hidden;
}

/* Animated Background */
.tcs-customization::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 20% 30%, rgba(255, 140, 66, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(210, 105, 30, 0.1) 0%, transparent 50%);
    animation: bgPulse 20s ease-in-out infinite;
}

@keyframes bgPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
}

.tcs-customization-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
}

/* Section Header */
.tcs-customization-header {
    text-align: center;
    margin-bottom: 60px;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tcs-customization-badge {
    display: inline-block;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 5px 15px rgba(255, 140, 66, 0.4);
}

.tcs-customization-title {
    font-size: 3rem;
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    line-height: 1.2;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.tcs-customization-subtitle {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Main Options Grid */
.tcs-customization-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 35px;
    margin-bottom: 50px;
}

/* 3D Option Card */
.tcs-option-card {
    perspective: 1500px;
    animation: fadeInScale 0.8s ease-out forwards;
    opacity: 0;
}

.tcs-option-card:nth-child(1) { animation-delay: 0.1s; }
.tcs-option-card:nth-child(2) { animation-delay: 0.2s; }
.tcs-option-card:nth-child(3) { animation-delay: 0.3s; }
.tcs-option-card:nth-child(4) { animation-delay: 0.4s; }

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.8) translateY(40px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.tcs-option-card-inner {
    position: relative;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(15px);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 35px 30px;
    height: 100%;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    overflow: hidden;
}

.tcs-option-card:hover .tcs-option-card-inner {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 140, 66, 0.4);
    transform: translateY(-15px) rotateX(8deg);
    box-shadow: 
        0 25px 50px rgba(0, 0, 0, 0.4),
        0 0 50px rgba(255, 140, 66, 0.3);
}

/* Gradient Background on Hover */
.tcs-option-card-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.1), rgba(210, 105, 30, 0.1));
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 20px;
    z-index: 0;
}

.tcs-option-card:hover .tcs-option-card-inner::before {
    opacity: 1;
}

/* Content Wrapper */
.tcs-option-content {
    position: relative;
    z-index: 1;
}

/* Icon Container */
.tcs-option-icon-container {
    position: relative;
    width: 80px;
    height: 80px;
    margin: 0 auto 25px;
    perspective: 1000px;
}

.tcs-option-icon {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
        0 10px 30px rgba(255, 140, 66, 0.4),
        inset 0 -5px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
    position: relative;
}

.tcs-option-icon::before {
    content: '';
    position: absolute;
    top: -6px;
    left: -6px;
    right: -6px;
    bottom: -6px;
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    border-radius: 18px;
    opacity: 0.5;
    filter: blur(20px);
    z-index: -1;
    transition: all 0.3s ease;
}

.tcs-option-card:hover .tcs-option-icon {
    transform: translateZ(30px) rotateY(10deg) scale(1.1);
    animation: iconBounce 0.6s ease;
}

.tcs-option-card:hover .tcs-option-icon::before {
    opacity: 0.8;
    filter: blur(25px);
}

@keyframes iconBounce {
    0%, 100% { transform: translateZ(30px) rotateY(10deg) scale(1.1); }
    50% { transform: translateZ(40px) rotateY(15deg) scale(1.15); }
}

.tcs-option-icon svg {
    width: 40px;
    height: 40px;
}

/* Option Title */
.tcs-option-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
    text-align: center;
    transition: color 0.3s ease;
}

.tcs-option-card:hover .tcs-option-title {
    color: #FFE8D6;
}

/* Option Description */
.tcs-option-description {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    text-align: center;
    margin-bottom: 25px;
    transition: color 0.3s ease;
}

.tcs-option-card:hover .tcs-option-description {
    color: rgba(255, 255, 255, 0.9);
}

/* Sub Options List */
.tcs-sub-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.tcs-sub-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 15px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    transition: all 0.3s ease;
    cursor: pointer;
}

.tcs-sub-option:hover {
    background: rgba(255, 140, 66, 0.2);
    transform: translateX(5px);
}

.tcs-sub-option-icon {
    width: 30px;
    height: 30px;
    background: rgba(255, 140, 66, 0.3);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tcs-sub-option-icon svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #FF8C42;
    stroke-width: 2;
}

.tcs-sub-option-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
}

/* Shine Effect */
.tcs-option-card-inner::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
        45deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
    );
    transform: rotate(45deg);
    transition: all 0.5s ease;
    opacity: 0;
}

.tcs-option-card:hover .tcs-option-card-inner::after {
    opacity: 1;
    animation: shine 0.8s ease;
}

@keyframes shine {
    from { left: -50%; }
    to { left: 150%; }
}

/* CTA Banner */
.tcs-customization-cta {
    text-align: center;
    padding: 50px 40px;
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.15), rgba(210, 105, 30, 0.15));
    border-radius: 20px;
    border: 2px solid rgba(255, 140, 66, 0.3);
    animation: fadeInUp 1s ease-out 0.8s backwards;
}

.tcs-customization-cta-title {
    font-size: 2rem;
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: 15px;
    font-family: 'Impact', 'Arial Black', sans-serif;
}

.tcs-customization-cta-text {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 30px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

.tcs-customization-cta-buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.tcs-customization-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 35px;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
}

.tcs-customization-btn-primary {
    background: linear-gradient(135deg, #FF8C42, #D2691E);
    color: white;
    box-shadow: 0 8px 25px rgba(255, 140, 66, 0.5);
}

.tcs-customization-btn-primary:hover {
    background: linear-gradient(135deg, #D2691E, #8B4513);
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(255, 140, 66, 0.6);
    color: white;
}

.tcs-customization-btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.3);
}

.tcs-customization-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 140, 66, 0.5);
    transform: translateY(-3px);
    color: white;
}

.tcs-customization-btn svg {
    width: 20px;
    height: 20px;
}

/* Responsive Design */
@media (max-width: 1024px) {
    .tcs-customization-title {
        font-size: 2.5rem;
    }
    
    .tcs-customization-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }
}

@media (max-width: 768px) {
    .tcs-customization {
        padding: 60px 0;
    }
    
    .tcs-customization-header {
        margin-bottom: 50px;
    }
    
    .tcs-customization-title {
        font-size: 2rem;
    }
    
    .tcs-customization-subtitle {
        font-size: 1rem;
    }
    
    .tcs-customization-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }
    
    .tcs-sub-options {
        grid-template-columns: 1fr;
    }
    
    .tcs-customization-cta {
        padding: 40px 25px;
    }
    
    .tcs-customization-cta-title {
        font-size: 1.6rem;
    }
    
    .tcs-customization-cta-buttons {
        flex-direction: column;
    }
    
    .tcs-customization-btn {
        width: 100%;
        justify-content: center;
    }
}

@media (max-width: 480px) {
    .tcs-customization-title {
        font-size: 1.75rem;
    }
    
    .tcs-option-card-inner {
        padding: 30px 25px;
    }
    
    .tcs-option-icon-container {
        width: 65px;
        height: 65px;
    }
    
    .tcs-option-icon svg {
        width: 35px;
        height: 35px;
    }
}

/* Performance Optimizations */
@media (prefers-reduced-motion: reduce) {
    .tcs-option-card,
    .tcs-customization-header,
    .tcs-option-icon,
    .tcs-customization::before {
        animation: none !important;
    }
}
</style>

