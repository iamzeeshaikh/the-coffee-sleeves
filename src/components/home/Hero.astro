<script is:inline>
(function() {
    'use strict';
    
    // 3D Tilt Effect on Mouse Move
    const productMain = document.querySelector('.tcs-hero-product-main');
    const productSecondary = document.querySelector('.tcs-hero-product-secondary');
    const hero3D = document.querySelector('.tcs-hero-3d-container');
    
    if (hero3D && window.innerWidth > 768) {
        hero3D.addEventListener('mousemove', function(e) {
            const rect = hero3D.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            const rotateX = (y - centerY) / 20;
            const rotateY = (centerX - x) / 20;
            
            if (productMain) {
                productMain.style.transform = `translate(-50%, -50%) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(20px)`;
            }
            
            if (productSecondary) {
                productSecondary.style.transform = `translateY(-10px) rotateZ(-8deg) scale(0.92) rotateX(${rotateX * 0.5}deg) rotateY(${rotateY * 0.5}deg)`;
            }
        });
        
        hero3D.addEventListener('mouseleave', function() {
            if (productMain) {
                productMain.style.transform = '';
            }
            if (productSecondary) {
                productSecondary.style.transform = '';
            }
        });
    }
    
    // Scroll Animation for Hero Elements
    function initScrollAnimations() {
        const heroLeft = document.querySelector('.tcs-hero-left');
        const heroRight = document.querySelector('.tcs-hero-right');
        
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -100px 0px'
        };
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);
        
        if (heroLeft) observer.observe(heroLeft);
        if (heroRight) observer.observe(heroRight);
    }
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollAnimations);
    } else {
        initScrollAnimations();
    }
    
    console.log('The Coffee Sleeves Hero - Initialized');
})();
</script>
